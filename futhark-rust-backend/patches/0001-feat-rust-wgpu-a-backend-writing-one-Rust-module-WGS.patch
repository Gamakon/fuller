--- /dev/null
+++ b/build_rust_wgpu.sh
@@ -0,0 +1,16 @@
+#!/bin/bash
+# Build this fork (cabal, GHC 9.14.1) and install its compiler as bin/futhark, the path fuller's rust-wgpu path uses
+# by default (fuller src/futhark_rust.rs; FUTHARK_RUST_WGPU overrides it). Run at nice 10.
+set -euo pipefail
+here=$(cd "$(dirname "$0")" && pwd)
+cd "$here"
+# Xcode's ld ahead of an older one on the PATH (anaconda's ld64-530 cannot read GHC's response files), and the SDK's
+# ffi.h, which Homebrew's GHC needs for its rts headers.
+export PATH=/usr/bin:/opt/homebrew/bin:$PATH
+export C_INCLUDE_PATH=$(xcrun --show-sdk-path)/usr/include/ffi
+nice -n 10 cabal build -j6 exe:futhark
+mkdir -p bin
+cp "$(cabal list-bin exe:futhark)" bin/futhark.new
+mv bin/futhark.new bin/futhark
+git rev-parse HEAD > bin/futhark.commit
+echo "installed $here/bin/futhark ($(cat bin/futhark.commit); uncommitted changes: $(git status --porcelain -- src | wc -l | tr -d ' '))"
