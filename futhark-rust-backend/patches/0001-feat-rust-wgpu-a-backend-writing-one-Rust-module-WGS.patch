+        es <- mapM resultOf vds
+        line $ "Ok(rt::Opaque::new(" <> strLit (nameToText oname) <> ", vec![" <> T.intercalate ", " (map (\e -> "rt::Value::from(" <> e <> ")") es) <> "]))"
+  line "}"
+  -- The dynamic adapter.
+  let dname = "dyn_" <> unique (nameToText (entryPointName ep))
+  line $ "/// The entry point `" <> nameToText (entryPointName ep) <> "` over dynamic values."
+  block ("pub fn " <> dname <> "(ctx: &rt::FutharkCtx, args: &[rt::Value]) -> Result<Vec<rt::Value>, rt::Error>") $ do
