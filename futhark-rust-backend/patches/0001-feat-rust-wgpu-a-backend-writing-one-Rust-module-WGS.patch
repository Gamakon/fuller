+-- | The @futhark rust-wgpu@ action: one Rust module, @<out>.rs@, whatever
+-- the compiler mode (a Rust module is always a library).
+compileRustWGPUAction :: FutharkConfig -> FilePath -> Action GPUMem
+compileRustWGPUAction fcfg tgtpath =
+  Action
+    { actionName = "Compile to Rust over wgpu-rs",
+      actionDescription = "Compile to a Rust module of WGSL kernels and host code over wgpu-rs",
+      actionProcedure = helper
+    }
+  where
+    helper prog = do
+      rust <- handleWarnings fcfg $ RustWGPU.compileProg versionString prog
+      let outpath =
+            if takeExtension tgtpath == ".rs"
+              then tgtpath
+              else tgtpath `addExtension` "rs"
+      liftIO $ T.writeFile outpath rust
+
