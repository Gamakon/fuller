+-- * The module
+
+-- | The built-in kernels, as the runtime instantiates them: a template, the
+-- element name and type, and whether the element is atomic. Checked against
+-- the interfaces 'builtinKernels' builds, so the two cannot disagree.
+builtinTemplates :: [(T.Text, T.Text, T.Text)]
+builtinTemplates =
+  [ ("lmad_copy_NAME", "TEMPLATE_LMAD_COPY", RTS.lmadCopy),
+    ("map_transpose_NAME", "TEMPLATE_MAP_TRANSPOSE", RTS.mapTranspose),
+    ("map_transpose_NAME_low_height", "TEMPLATE_MAP_TRANSPOSE_LOW_HEIGHT", RTS.mapTransposeLowHeight),
+    ("map_transpose_NAME_low_width", "TEMPLATE_MAP_TRANSPOSE_LOW_WIDTH", RTS.mapTransposeLowWidth),
+    ("map_transpose_NAME_small", "TEMPLATE_MAP_TRANSPOSE_SMALL", RTS.mapTransposeSmall),
+    ("map_transpose_NAME_large", "TEMPLATE_MAP_TRANSPOSE_LARGE", RTS.mapTransposeLarge)
+  ]
+
+builtinElems :: [(T.Text, T.Text, Bool)]
+builtinElems = [("1b", "i8", True), ("2b", "i16", True), ("4b", "i32", False), ("8b", "i64", False)]
+
+-- | The runtime's description of a built-in kernel, or nothing for one of the
+-- program's own.
+builtinSource :: Name -> KernelInterface -> Maybe T.Text
+builtinSource n k =
+  case [ (const_name, tmpl, ename, ety, atomic)
+       | (pattern, const_name, tmpl) <- builtinTemplates,
+         (ename, ety, atomic) <- builtinElems,
+         T.replace "NAME" ename pattern == nameToText n
+       ] of
+    [(const_name, tmpl, ename, ety, atomic)]
+      | gpuProgram k == instantiate tmpl ename ety atomic ->
+          Just $
+            "Some(rt::BuiltinSource { template: "
+              <> const_name
+              <> ", name: "
+              <> strLit ename
+              <> ", elem: "
+              <> strLit ety
+              <> ", atomic: "
+              <> (if atomic then "true" else "false")
+              <> " })"
+      | otherwise ->
+          compilerLimitation $ "The rust-wgpu backend's instantiation of " <> nameToText n <> " differs from the webgpu backend's."
+    _ -> Nothing
+  where
+    instantiate kernel name elemType atomic =
+      let baseKernel =
+            if atomic
+              then T.replace "<ELEM_TYPE>" "<atomic<ELEM_TYPE>>" kernel
+              else kernel
+       in RTS.wgslPrelude <> T.replace "NAME" name (T.replace "ELEM_TYPE" elemType baseKernel)
+
+kernelInfo :: (Name, KernelInterface) -> T.Text
+kernelInfo (n, k) =
+  T.unlines
+    [ "    rt::KernelInfo {",
+      "        name: " <> strLit (zEncodeText (nameToText n)) <> ",",
+      "        scalars_binding: " <> showT (scalarsBindSlot k) <> ",",
+      "        scalars_size: " <> showT (scalarsSize k) <> ",",
+      "        scalar_offsets: &[" <> T.intercalate ", " (map showT (scalarsOffsets k)) <> "],",
+      "        binding_indices: &[" <> T.intercalate ", " (map showT (memBindSlots k)) <> "],",
+      "        used_overrides: &[" <> T.intercalate ", " (map strLit (overrideNames k)) <> "],",
+      "        dynamic_block_dims: &[" <> T.intercalate ", " ["(" <> showT i <> ", " <> strLit d <> ")" | (i, d) <- dynamicBlockDims k] <> "],",
+      "        shared_mem_overrides: &[" <> T.intercalate ", " (map strLit (sharedMemoryOverrides k)) <> "],",
+      "        builtin: " <> fromMaybe "None" (builtinSource n k) <> ",",
+      "    },"
+    ]
+
+generate ::
+  T.Text ->
+  T.Text ->
+  T.Text ->
+  [(Name, KernelConstExp)] ->
+  M.Map Name KernelInterface ->
+  Definitions HostOp ->
+  T.Text
+generate version wgsl prelude macros kernels (Definitions params _types consts (Functions funs)) =
+  T.unlines (reverse (gsLines final))
+  where
+    all_kernels = M.toList (M.union kernels builtinKernels)
+    kernel_idx = M.fromList $ zip (map fst all_kernels) [0 ..]
+    tuning = M.toList params
+    tuning_idx = M.fromList $ zip (map fst tuning) [0 ..]
+    const_names = S.fromList $ map paramName (constsDecl consts)
+    const_types = paramDecls (constsDecl consts)
+    env =
+      Env
+        { envConsts = const_names,
+          envFuns = M.fromList funs,
+          envKernelIdx = kernel_idx,
+          envTuning = tuning_idx,
+          envMentioned = mempty,
+          envTypes = const_types
+        }
+    (_, final, ()) = runRWS gen env (GenS [] 0 0 False False)
+    gen = do
+      line "// Generated by Futhark's rust-wgpu backend. Do not edit."
+      forM_ (T.lines version) $ \l -> line $ "// " <> l
+      line "//"
+      line "// One program: its entry points are `pub fn`s over `rt::FutharkCtx`; `ENTRIES` lists them with"
+      line "// their types for a host that loads this module dynamically."
+      line ""
+      line "use futhark_rust_rt as rt;"
+      line ""
+      line $ "/// The program's WGSL: the prelude and every kernel, one module."
+      line $ "pub const WGSL_PROGRAM: &str = " <> rawLit wgsl <> ";"
+      line ""
+      line "/// The WGSL prelude the built-in kernels are instantiated with."
+      line $ "pub const WGSL_PRELUDE: &str = " <> rawLit prelude <> ";"
+      forM_ builtinTemplates $ \(_, const_name, tmpl) -> do
+        line ""
+        line $ "pub const " <> const_name <> ": &str = " <> rawLit tmpl <> ";"
+      line ""
+      line "/// Every kernel: the program's own and the built-in copies and transpositions."
+      line "pub static KERNELS: &[rt::KernelInfo] = &["
+      mapM_ (mapM_ line . T.lines . kernelInfo) all_kernels
+      line "];"
+      line ""
+      line "/// The tuning parameters: name, class, default."
+      line "pub static TUNING: &[rt::TuningParam] = &["
+      forM_ tuning $ \(n, (cls, _)) ->
+        line $
+          "    rt::TuningParam { name: "
+            <> strLit (prettyText n)
+            <> ", class: "
+            <> strLit (maybe "custom" prettyText cls)
+            <> ", default: "
+            <> showT (maybe 0 (fromMaybe 0 . sizeDefault) cls)
+            <> " },"
+      line "];"
+      line ""
+      line "/// The macro definitions: override constants, evaluated once per context."
+      line $ "pub static MACRO_NAMES: &[&str] = &[" <> T.intercalate ", " (map (strLit . nameToText . fst) macros) <> "];"
+      line ""
+      (macroLines, macroCtx, _) <- capture $ indented $ do
+        es <- forM macros $ \(_, e) -> do
+          e' <- compileConstExp "tuning" "set" e
+          pure $ e' <> " as i64 as f64"
+        line $ "vec![" <> T.intercalate ", " es <> "]"
+      let usesTuning = any (T.isInfixOf "tuning[") macroLines
+          usesSet = any (T.isInfixOf "set[") macroLines
+      line $
+        "pub fn macro_values("
+          <> (if macroCtx then "ctx" else "_")
+          <> ": &rt::FutharkCtx, "
+          <> (if usesTuning then "tuning" else "_")
+          <> ": &[i64], "
+          <> (if usesSet then "set" else "_")
+          <> ": &[bool]) -> Vec<f64> {"
+      emitLines macroLines
+      line "}"
+      line ""
+      line "pub static PROGRAM: rt::ProgramDesc = rt::ProgramDesc {"
+      line "    wgsl: WGSL_PROGRAM,"
+      line "    prelude: WGSL_PRELUDE,"
+      line "    kernels: KERNELS,"
+      line "    tuning: TUNING,"
+      line "    macro_names: MACRO_NAMES,"
+      line "    macro_values,"
+      line "};"
+      line ""
+      line "/// The program's state in one context: its tuning, its pipelines' overrides, its constants."
+      block "pub struct State" $ do
+        line "pub prog: rt::Program,"
+        forM_ (constsDecl consts) $ \p -> line $ "pub " <> vname (paramName p) <> ": " <> outType' p <> ","
+      line ""
+      line "/// The program's state in this context, made (and its constants initialised) on first use."
+      line "pub fn state(ctx: &rt::FutharkCtx) -> Result<std::rc::Rc<State>, rt::Error> {"
+      line "    ctx.module_state::<State, _>(|ctx| {"
+      line "        let st = State {"
+      line "            prog: rt::Program::new(ctx, &PROGRAM),"
+      forM_ (constsDecl consts) $ \p -> line $ "            " <> vname (paramName p) <> ": " <> constInit p <> ","
+      line "        };"
+      line "        init_constants(ctx, &st)?;"
+      line "        Ok(st)"
+      line "    })"
+      line "}"
+      line ""
+      withFunction [] (constsInit consts) $ do
+        (initLines, initCtx, initSt) <- capture $ indented $ do
+          compileCode (constsInit consts)
+          line "Ok(())"
+        line $
+          "pub fn init_constants("
+            <> (if initCtx then "ctx" else "_")
+            <> ": &rt::FutharkCtx, "
+            <> (if initSt then "st" else "_")
+            <> ": &State) -> Result<(), rt::Error> {"
+        emitLines initLines
+        line "}"
+      forM_ funs $ \(n, f) -> do
+        line ""
+        genFunction n f
+      forM_ funs $ \(n, f) -> forM_ (functionEntry f) $ \ep -> do
+        line ""
+        genEntry n f ep
+      line ""
+      line "/// Every entry point, with its types, over dynamic values."
+      line "pub static ENTRIES: &[rt::EntryDesc] = &["
+      forM_ (mapMaybe functionEntry (map snd funs)) $ \ep -> do
+        let ins = concatMap (valueDescs . snd) (entryPointArgs ep)
+            outs = valueDescs (snd (entryPointResults ep))
+        line $
+          "    rt::EntryDesc { name: "
+            <> strLit (nameToText (entryPointName ep))
+            <> ", inputs: &["
+            <> T.intercalate ", " (map typeDesc ins)
+            <> "], outputs: &["
+            <> T.intercalate ", " (map typeDesc outs)
+            <> "], call: dyn_"
+            <> unique (nameToText (entryPointName ep))
+            <> " },"
+      line "];"
+    outType' (ScalarParam _ t) = "rt::Var<" <> rustPrim t <> ">"
+    outType' (MemParam _ space) = memType space
+    constInit (ScalarParam _ t) = "rt::Var::<" <> rustPrim t <> ">::new(" <> zeroOf t <> ")"
+    constInit (MemParam _ space) = memType space <> "::new()"
