diff --git a/rts/c/backends/webgpu.h b/rts/c/backends/webgpu.h
index 280bdfb95..7369f183c 100644
--- a/rts/c/backends/webgpu.h
+++ b/rts/c/backends/webgpu.h
@@ -338,6 +338,9 @@ struct futhark_context {
   size_t lockstep_width;
   size_t max_thread_block_size;
   size_t max_grid_size;
+  // The device's blocks per dispatch dimension; a 1-D grid over it is dispatched as a rectangle
+  // (gpu_launch_kernel), and the kernel reads its block count from its scalars (grid_x_offset).
+  uint32_t max_workgroups_per_dimension;
   size_t max_tile_size;
   size_t max_threshold;
   size_t max_shared_memory;
@@ -507,6 +510,7 @@ int backend_context_setup(struct futhark_context *ctx) {
   required_limits.maxComputeWorkgroupSizeY = supported.maxComputeWorkgroupSizeY;
   required_limits.maxComputeWorkgroupSizeZ = supported.maxComputeWorkgroupSizeZ;
   required_limits.maxComputeWorkgroupsPerDimension = supported.maxComputeWorkgroupsPerDimension;
+  ctx->max_workgroups_per_dimension = supported.maxComputeWorkgroupsPerDimension;
 
   // Require support for 16-bit floats
   WGPUFeatureName required_features[] = { WGPUFeatureName_ShaderF16 };
@@ -1007,6 +1011,22 @@ static int gpu_launch_kernel(struct futhark_context* ctx,
     memcpy(scalars + kernel_info->scalar_offsets[i],
         args[scalars_start + i], args_sizes[scalars_start + i]);
   }
+  // The kernel's own block count, and the dispatch folded into two dimensions when the 1-D grid is over the
+  // device's limit: x * y >= grid[0] blocks with x <= the limit, the excess (fewer than y) returning at once.
+  uint32_t dispatch[3] = { (uint32_t)grid[0], (uint32_t)grid[1], (uint32_t)grid[2] };
+  if (kernel_info->grid_x_offset >= 0) {
+    uint32_t grid_x = (uint32_t)grid[0];
+    memcpy(scalars + kernel_info->grid_x_offset, &grid_x, sizeof grid_x);
+  }
+  if (dispatch[0] > ctx->max_workgroups_per_dimension) {
+    if (dispatch[1] != 1 || dispatch[2] != 1) {
+      futhark_panic(-1, "Kernel %s: a grid of %u x %u x %u blocks is over the device's %u blocks a dimension\n",
+                    name, dispatch[0], dispatch[1], dispatch[2], ctx->max_workgroups_per_dimension);
+    }
+    uint32_t y = (dispatch[0] + ctx->max_workgroups_per_dimension - 1) / ctx->max_workgroups_per_dimension;
+    dispatch[1] = y;
+    dispatch[0] = (dispatch[0] + y - 1) / y;
+  }
 
   WGPUBindGroupEntry *bg_entries = calloc(1 + kernel_info->num_bindings,
                                           sizeof(WGPUBindGroupEntry));
@@ -1073,7 +1093,7 @@ static int gpu_launch_kernel(struct futhark_context* ctx,
   wgpuComputePassEncoderSetPipeline(pass_encoder, pipeline);
   wgpuComputePassEncoderSetBindGroup(pass_encoder, 0, bg, 0, NULL);
   wgpuComputePassEncoderDispatchWorkgroups(pass_encoder,
-                                           grid[0], grid[1], grid[2]);
+                                           dispatch[0], dispatch[1], dispatch[2]);
   wgpuComputePassEncoderEnd(pass_encoder);
 
   WGPUCommandBuffer cmd_buffer = wgpuCommandEncoderFinish(encoder, NULL);
