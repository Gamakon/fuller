From b781874841322b111d7f1f708f988a52c075f9a9 Mon Sep 17 00:00:00 2001
From: futhark-rust-backend <none>
Date: Thu, 5 Nov 2026 02:55:12 +0000
Subject: [PATCH 15/16] fix(fusion): a kernel turned into a stream has its
 lambda renamed

When a scan kernel is turned into a stream to fuse with a stream
producer, soacToStream names the stream's extra accumulator results
after the parameters of its own lambda, and those results become output
names of the kernel. The producer's lambda is renamed on its way into
the fused SOAC, the kernel's was not, so each such name was bound twice:
by the statement and by the lambda ("Type error after pass 'Fuse SOACs'
... Name inpacc_... bound twice"). Present in Futhark 0.28.1 and on
master. Only a scan's stream (the one that returns such names) is
renamed, so a program that compiled before compiles to the same code.
Test: tests/fusion/scan-stream-horizontal.fut
---
 src/Futhark/Optimise/Fusion/TryFusion.hs | 16 ++++++++++++++--
 tests/fusion/scan-stream-horizontal.fut  | 19 +++++++++++++++++++
 2 files changed, 33 insertions(+), 2 deletions(-)
 create mode 100644 tests/fusion/scan-stream-horizontal.fut

diff --git a/src/Futhark/Optimise/Fusion/TryFusion.hs b/src/Futhark/Optimise/Fusion/TryFusion.hs
index 61bfdd4e2..42e7c32a7 100644
--- a/src/Futhark/Optimise/Fusion/TryFusion.hs
+++ b/src/Futhark/Optimise/Fusion/TryFusion.hs
@@ -368,13 +368,25 @@ fuseSOACwithKer mode unfus_set outVars soac_p0 ker = do
       -- sequential/parallel property of the soac_p stream.
       (soac_c', newacc_ids) <- SOAC.soacToStream soac_c
       if soac_c' /= soac_c
-        then
+        then do
+          -- A scan's stream names its extra accumulator results after
+          -- the parameters of its own lambda ('soacToStream'), and those
+          -- results become output names of the kernel here. Unlike the
+          -- producer, the kernel's lambda is not renamed on the way into
+          -- the fused SOAC, so it must be renamed now, or each such name
+          -- is bound twice: by the statement and by the lambda. (A
+          -- reduction's stream returns no such names and is left as it
+          -- was.)
+          soac_c'' <-
+            if null newacc_ids
+              then pure soac_c'
+              else flip SOAC.setLambda soac_c' <$> renameLambda (SOAC.lambda soac_c')
           fuseSOACwithKer
             mode
             (namesFromList (map identName newacc_ids) <> unfus_set)
             outVars
             soac_p
-            $ ker {fsSOAC = soac_c', fsOutNames = map identName newacc_ids ++ fsOutNames ker}
+            $ ker {fsSOAC = soac_c'', fsOutNames = map identName newacc_ids ++ fsOutNames ker}
         else fail "SOAC could not be turned into stream."
 
 fuseStreamHelper ::
diff --git a/tests/fusion/scan-stream-horizontal.fut b/tests/fusion/scan-stream-horizontal.fut
new file mode 100644
index 000000000..924927afa
--- /dev/null
+++ b/tests/fusion/scan-stream-horizontal.fut
@@ -0,0 +1,19 @@
+-- A scan fused into a reduction becomes a stream, and a second scan of
+-- the same input then fuses into that stream horizontally. The second
+-- scan's stream named its accumulator results after its own lambda's
+-- parameters, so each name was bound twice ("Name inpacc_... bound
+-- twice" after 'Fuse SOACs').
+-- ==
+-- input { [1,-5,3] } output { -4 [1,1,3] }
+-- input { empty([0]i32) } output { 2147483647 empty([0]i32) }
+
+entry main [n] (xs: [n]i32) : (i32, [n]i32) =
+  (i32.minimum (scan (+) 0 xs), scan i32.max i32.lowest xs)
+
+-- The same scan twice, which CSE makes one scan with two consumers.
+-- ==
+-- entry: twice
+-- input { [1,-5,3] } output { -4 [1,-4,-1] }
+
+entry twice [n] (xs: [n]i32) : (i32, [n]i32) =
+  (i32.minimum (scan (+) 0 xs), scan (+) 0 xs)
