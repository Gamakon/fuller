From c48e4a353b94b49521b6230ba89ab1cc5e48c97d Mon Sep 17 00:00:00 2001
From: andrew-gamakon <andrew@gamakon.ai>
Date: Wed, 28 Oct 2026 12:14:08 +0100
Subject: [PATCH 5/5] fix(rust-wgpu): the name-key helper renamed nameKey (it
 shadowed local bindings named key)

---
 src/Futhark/CodeGen/Backends/RustWGPU.hs | 76 ++++++++++++------------
 1 file changed, 38 insertions(+), 38 deletions(-)

diff --git a/src/Futhark/CodeGen/Backends/RustWGPU.hs b/src/Futhark/CodeGen/Backends/RustWGPU.hs
index 2249f23..aa91532 100644
--- a/src/Futhark/CodeGen/Backends/RustWGPU.hs
+++ b/src/Futhark/CodeGen/Backends/RustWGPU.hs
@@ -162,7 +162,7 @@ vname v = "v_" <> (if T.null b then "" else b <> "_") <> showT (baseTag v)
 varRef :: VName -> GenM T.Text
 varRef v = do
   cs <- asks envConsts
-  if key v `S.member` cs
+  if nameKey v `S.member` cs
     then (<> ("." <> vname v)) <$> stRef
     else pure $ vname v
 
@@ -357,7 +357,7 @@ bare t
 compileExpP :: Exp -> GenM T.Text
 compileExpP = compilePE $ \v t -> do
   v' <- varRef v
-  declared <- asks $ M.lookup (key v) . envTypes
+  declared <- asks $ M.lookup (nameKey v) . envTypes
   -- A variable read at another type than it was declared with: C's implicit conversion.
   pure $ maybe id (convertTo t) declared (v' <> ".get()")
 
@@ -418,12 +418,12 @@ convertFromI64 t e = "(" <> e <> " as " <> rustPrim t <> ")"
 -- tag (a batch's @counters_mem_13190@ and @segred_tmp_mem_13190@), as can
 -- Futhark's 'Names' (keyed by tag); the C backend keeps them apart by
 -- spelling them, and so does this one.
-key :: VName -> T.Text
-key = prettyText
+nameKey :: VName -> T.Text
+nameKey = prettyText
 
 -- | The names an expression mentions.
 expNames :: (Foldable f) => f VName -> S.Set T.Text
-expNames = foldMap (S.singleton . key)
+expNames = foldMap (S.singleton . nameKey)
 
 texpNames :: TExp t -> S.Set T.Text
 texpNames = expNames . untyped
@@ -432,7 +432,7 @@ countNames :: Count u (TExp t) -> S.Set T.Text
 countNames = texpNames . unCount
 
 keys :: [VName] -> S.Set T.Text
-keys = S.fromList . map key
+keys = S.fromList . map nameKey
 
 -- | Every name mentioned anywhere in the code other than at its declaration.
 mentioned :: Code HostOp -> S.Set T.Text
@@ -444,21 +444,21 @@ mentioned DeclareMem {} = mempty
 mentioned DeclareScalar {} = mempty
 mentioned DeclareArray {} = mempty
 mentioned (Op op) = hostOpNames op
-mentioned (Allocate v size _) = S.insert (key v) (countNames size)
-mentioned (Free v _) = S.singleton (key v)
+mentioned (Allocate v size _) = S.insert (nameKey v) (countNames size)
+mentioned (Free v _) = S.singleton (nameKey v)
 mentioned (Copy _ shape (dst, _) (doff, dstrides) (src, _) (soff, sstrides)) =
   keys [dst, src] <> foldMap countNames (shape <> dstrides <> sstrides) <> countNames doff <> countNames soff
-mentioned (Write v i _ _ _ e) = S.insert (key v) (countNames i <> expNames e)
+mentioned (Write v i _ _ _ e) = S.insert (nameKey v) (countNames i <> expNames e)
 mentioned (Read x v i _ _ _) = keys [x, v] <> countNames i
-mentioned (SetScalar x e) = S.insert (key x) (expNames e)
+mentioned (SetScalar x e) = S.insert (nameKey x) (expNames e)
 mentioned (SetMem x y _) = keys [x, y]
 mentioned (Call dests _ args) = keys dests <> foldMap argNames args
   where
     argNames (ExpArg e) = expNames e
-    argNames (MemArg v) = S.singleton (key v)
+    argNames (MemArg v) = S.singleton (nameKey v)
 mentioned (Assert e msg _) = expNames e <> foldMap expNames msg
 mentioned (TracePrint msg) = foldMap expNames msg
-mentioned (GetUserParam v _ def) = S.insert (key v) (texpNames def)
+mentioned (GetUserParam v _ def) = S.insert (nameKey v) (texpNames def)
 mentioned Skip = mempty
 mentioned Meta {} = mempty
 mentioned DebugPrint {} = mempty
@@ -468,39 +468,39 @@ hostOpNames (LaunchKernel _ _ shared args grid block_dims) =
   countNames shared <> foldMap argNames args <> foldMap expNames grid <> foldMap blockNames block_dims
   where
     argNames (ValueKArg e _) = expNames e
-    argNames (MemKArg v) = S.singleton (key v)
+    argNames (MemKArg v) = S.singleton (nameKey v)
     blockNames (Left e) = expNames e
     blockNames (Right _) = mempty
-hostOpNames (GetSize v _) = S.singleton (key v)
-hostOpNames (CmpSizeLe v _ x) = S.insert (key v) (expNames x)
-hostOpNames (GetSizeMax v _) = S.singleton (key v)
+hostOpNames (GetSize v _) = S.singleton (nameKey v)
+hostOpNames (CmpSizeLe v _ x) = S.insert (nameKey v) (expNames x)
+hostOpNames (GetSizeMax v _) = S.singleton (nameKey v)
 
 -- | The declared scalar types of a body.
 declarations :: Code a -> M.Map T.Text PrimType
 declarations (x :>>: y) = declarations x <> declarations y
-declarations (For i bound body) = M.singleton (key i) (primExpType bound) <> declarations body
+declarations (For i bound body) = M.singleton (nameKey i) (primExpType bound) <> declarations body
 declarations (While _ body) = declarations body
 declarations (If _ t f) = declarations t <> declarations f
-declarations (DeclareScalar v _ t) = M.singleton (key v) t
+declarations (DeclareScalar v _ t) = M.singleton (nameKey v) t
 declarations _ = mempty
 
 paramDecls :: [Param] -> M.Map T.Text PrimType
 paramDecls = foldMap one
   where
-    one (ScalarParam v t) = M.singleton (key v) t
+    one (ScalarParam v t) = M.singleton (nameKey v) t
     one MemParam {} = mempty
 
 -- * Statements
 
 isMentioned :: VName -> GenM Bool
-isMentioned v = asks $ S.member (key v) . envMentioned
+isMentioned v = asks $ S.member (nameKey v) . envMentioned
 
 compileCode :: Code HostOp -> GenM ()
 compileCode Skip = pure ()
 compileCode (x :>>: y) = compileCode x >> compileCode y
 compileCode (For i bound body) = do
   b <- compileExp bound
-  let used = key i `S.member` mentioned body
+  let used = nameKey i `S.member` mentioned body
       t = rustPrim (primExpType bound)
       range = zeroOf (primExpType bound) <> ".." <> b
   if used
@@ -734,7 +734,7 @@ compileHostOp (LaunchKernel _safety kname _shared args grid block_dims) = do
 scalarType :: VName -> GenM PrimType
 scalarType v = do
   m <- asks envTypes
-  case M.lookup (key v) m of
+  case M.lookup (nameKey v) m of
     Just t -> pure t
     Nothing -> compilerLimitation $ "The rust-wgpu backend does not know the type of " <> prettyText v
 
@@ -764,11 +764,11 @@ genFunction fname fun = withFunction (functionInput fun <> functionOutput fun) (
   (bodyLines, usesCtx, usesSt) <- capture $ indented $ do
     forM_ (functionInput fun) $ \case
       ScalarParam v t
-        | key v `S.member` ment ->
+        | nameKey v `S.member` ment ->
             line $ "let " <> vname v <> " = rt::Var::<" <> rustPrim t <> ">::new(" <> vname v <> ");"
         | otherwise -> pure ()
       MemParam v _
-        | key v `S.member` ment -> line $ "let " <> vname v <> " = " <> vname v <> ".clone();"
+        | nameKey v `S.member` ment -> line $ "let " <> vname v <> " = " <> vname v <> ".clone();"
         | otherwise -> pure ()
     forM_ (functionOutput fun) $ \case
       ScalarParam v t -> line $ "let " <> vname v <> " = rt::Var::<" <> rustPrim t <> ">::new(" <> zeroOf t <> ");"
@@ -778,10 +778,10 @@ genFunction fname fun = withFunction (functionInput fun <> functionOutput fun) (
         ret (MemParam v _) = vname v
     line $ "Ok(" <> (if null (functionOutput fun) then "()" else "(" <> T.intercalate ", " (map ret (functionOutput fun)) <> ",)") <> ")"
   let param (ScalarParam v t)
-        | key v `S.member` ment = vname v <> ": " <> rustPrim t
+        | nameKey v `S.member` ment = vname v <> ": " <> rustPrim t
         | otherwise = "_: " <> rustPrim t
       param (MemParam v space)
-        | key v `S.member` ment = vname v <> ": &" <> memType space
+        | nameKey v `S.member` ment = vname v <> ": &" <> memType space
         | otherwise = "_: &" <> memType space
       params =
         [ (if usesCtx then "ctx" else "_") <> ": &rt::FutharkCtx",
@@ -837,28 +837,28 @@ genEntry fname fun ep = do
     line "let st = state(ctx)?;"
     bind <- foldM bindArg (ArgBind mempty mempty) (zip [0 ..] (map snd args))
     inArgs <- forM (functionInput fun) $ \case
-      MemParam v _ -> case M.lookup (key v) (abMem bind) of
+      MemParam v _ -> case M.lookup (nameKey v) (abMem bind) of
         Just e -> pure e
         Nothing -> compilerLimitation $ "The rust-wgpu backend cannot bind the memory parameter " <> prettyText v
-      ScalarParam v _ -> case M.lookup (key v) (abScalar bind) of
+      ScalarParam v _ -> case M.lookup (nameKey v) (abScalar bind) of
         Just e -> pure e
         Nothing -> compilerLimitation $ "The rust-wgpu backend cannot bind the scalar parameter " <> prettyText v
     let outs = functionOutput fun
-        outIdx = M.fromList $ zip (map (key . paramName) outs) [(0 :: Int) ..]
+        outIdx = M.fromList $ zip (map (nameKey . paramName) outs) [(0 :: Int) ..]
         callText = funName fname <> "(" <> T.intercalate ", " ("ctx" : "&st" : inArgs) <> ")?"
     line $ (if null outs then "" else "let r = ") <> callText <> ";"
     let dimExp (Constant (IntValue v)) = pure $ showT (valueIntegral v :: Integer) <> "i64"
         dimExp (Constant v) = compilerLimitation $ "The rust-wgpu backend found a non-integer dimension " <> prettyText v
-        dimExp (Var v) = case M.lookup (key v) outIdx of
+        dimExp (Var v) = case M.lookup (nameKey v) outIdx of
           Just k -> pure $ "r." <> showT k
-          Nothing -> case M.lookup (key v) (abScalar bind) of
+          Nothing -> case M.lookup (nameKey v) (abScalar bind) of
             Just e -> pure e
             Nothing -> compilerLimitation $ "The rust-wgpu backend cannot find the dimension " <> prettyText v
-        scalarOut v = case M.lookup (key v) outIdx of
+        scalarOut v = case M.lookup (nameKey v) outIdx of
           Just k -> pure $ "r." <> showT k
           Nothing -> compilerLimitation $ "The rust-wgpu backend cannot find the result " <> prettyText v
         resultOf (ArrayValue mem _ pt s dims) = do
-          k <- case M.lookup (key mem) outIdx of
+          k <- case M.lookup (nameKey mem) outIdx of
             Just k -> pure k
             Nothing -> compilerLimitation $ "The rust-wgpu backend cannot find the result memory " <> prettyText mem
           dims' <- mapM dimExp dims
@@ -900,17 +900,17 @@ genEntry fname fun ep = do
     bindArg bind (i, TransparentValue (ArrayValue mem _ _ _ dims)) = do
       let a = "a" <> showT (i :: Int)
       bind' <- foldM (bindDim a) bind (zip [0 :: Int ..] dims)
-      pure bind' {abMem = M.insert (key mem) (a <> ".mem()") (abMem bind')}
+      pure bind' {abMem = M.insert (nameKey mem) (a <> ".mem()") (abMem bind')}
     bindArg bind (i, TransparentValue (ScalarValue pt s v)) = do
       let a = "a" <> showT (i :: Int)
           e = if rustExtPrim s pt /= rustPrim pt then "(" <> a <> " as " <> rustPrim pt <> ")" else a
-      pure bind {abScalar = M.insert (key v) e (abScalar bind)}
+      pure bind {abScalar = M.insert (nameKey v) e (abScalar bind)}
     bindArg _ (_, OpaqueValue {}) = compilerLimitation "The rust-wgpu backend does not support opaque entry point arguments."
     bindDim a bind (d, dim) = do
       let shape = a <> ".shape()[" <> showT d <> "]"
       case dim of
-        Var v -> case M.lookup (key v) (abScalar bind) of
-          Nothing -> pure bind {abScalar = M.insert (key v) shape (abScalar bind)}
+        Var v -> case M.lookup (nameKey v) (abScalar bind) of
+          Nothing -> pure bind {abScalar = M.insert (nameKey v) shape (abScalar bind)}
           Just e -> do
             line $ "rt::check_dim(" <> strLit (nameToText (entryPointName ep)) <> ", " <> shape <> ", " <> e <> ")?;"
             pure bind
@@ -1000,7 +1000,7 @@ generate version wgsl prelude macros kernels (Definitions params _types consts (
     kernel_idx = M.fromList $ zip (map fst all_kernels) [0 ..]
     tuning = M.toList params
     tuning_idx = M.fromList $ zip (map fst tuning) [0 ..]
-    const_names = S.fromList $ map (key . paramName) (constsDecl consts)
+    const_names = S.fromList $ map (nameKey . paramName) (constsDecl consts)
     const_types = paramDecls (constsDecl consts)
     env =
       Env
-- 
2.50.1 (Apple Git-155)

