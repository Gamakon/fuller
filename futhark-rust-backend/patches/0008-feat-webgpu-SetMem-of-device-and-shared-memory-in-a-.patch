+-- | A memory block in a kernel is a module-scope WGSL binding (a storage
+-- buffer, or a workgroup array), never a runtime value: WGSL has no variable
+-- that holds a storage or workgroup pointer. A 'SetMem' @x <- y@ of
+-- non-register memory makes @x@ a memory variable, and the bindings @x@ can
+-- name are the bindings its SetMem sources can name, transitively. This
+-- computes them for every memory variable of the kernel:
+--
+-- * a variable that can name one binding only is that binding everywhere
+--   (renamed), whatever loops and conditionals its SetMems are in;
+--
+-- * a variable that can name several (a loop's memory parameter that starts
+--   at one buffer and is rotated to another, inside a bounds check) gets a
+--   selector, a function-scope @i32@ holding the number of the binding it
+--   names now. Its SetMems assign the selector, and each statement that
+--   accesses memory through it is translated once per candidate binding,
+--   under a test of the selector ('genMemAccess'). That is exactly the
+--   pointer assignment and dereference of Futhark's OpenCL and CUDA kernels,
+--   spelled for WGSL.
+analyseMemVars :: KernelM ()
+analyseMemVars = do
+  kernel <- asks krKernel
+  let body = ImpGPU.kernelBody kernel
+      bindings =
+        nubOrd $
+          [n | ImpGPU.MemoryUse n <- ImpGPU.kernelUses kernel] <> sharedAllocs body
+      ids = M.fromList $ zip bindings [0 ..]
+      edges = setMems body
+      vars = nubOrd $ map fst edges
+      sources x = [y | (x', y) <- edges, x' == x]
+      reach seen [] = seen
+      reach seen (v : vs)
+        | v `S.member` seen = reach seen vs
+        | otherwise = reach (S.insert v seen) (sources v <> vs)
+      cands x =
+        let reached = reach mempty (sources x)
+         in [b | b <- bindings, b `S.member` reached]
+  forM_ vars $ \x ->
+    when (x `M.member` ids) $
+      compilerLimitation $
+        "WebGPU backend cannot assign the memory binding " <> prettyText x <> " in a GPU kernel."
+  forM_ edges $ \(_, y) ->
+    unless (y `M.member` ids || y `elem` vars) $
+      compilerLimitation $
+        "WebGPU backend cannot resolve a SetMem source " <> prettyText y <> " that is neither a binding nor a memory variable of the GPU kernel."
+  let candMap = M.fromList [(x, cands x) | x <- vars]
+  forM_ (M.toList candMap) $ \(x, cs) ->
+    when (null cs) $
+      compilerLimitation $
+        "WebGPU backend found no binding the memory variable " <> prettyText x <> " can name in a GPU kernel."
+  modify $ \s ->
+    s
+      { ksMemCands = candMap,
+        ksMemSelect = S.fromList [x | (x, _ : _ : _) <- M.toList candMap],
+        ksBindingIds = ids
+      }
+  where
+    -- A shared allocation is a workgroup array; a shared memory block that
+    -- is only declared and assigned (a loop's double buffer) is a variable.
+    sharedAllocs (Op (ImpGPU.SharedAlloc n _)) = [n]
+    sharedAllocs (s1 :>>: s2) = sharedAllocs s1 <> sharedAllocs s2
+    sharedAllocs (For _ _ b) = sharedAllocs b
+    sharedAllocs (While _ b) = sharedAllocs b
+    sharedAllocs (If _ s1 s2) = sharedAllocs s1 <> sharedAllocs s2
+    sharedAllocs _ = []
+    setMems (SetMem _ _ (ScalarSpace _ _)) = []
+    setMems (SetMem x y _) = [(x, y)]
+    setMems (s1 :>>: s2) = setMems s1 <> setMems s2
+    setMems (For _ _ b) = setMems b
+    setMems (While _ b) = setMems b
+    setMems (If _ s1 s2) = setMems s1 <> setMems s2
+    setMems _ = []
+
+-- | The memory variables' renames (one candidate) and selectors (several).
+-- Run after 'genMemoryDecls'. A binding's WGSL name is its module-scope name
+-- ('mkGlobalIdent'), for a memory use and a shared allocation alike.
+genMemVarDecls :: KernelM ()
+genMemVarDecls = do
+  cands <- gets ksMemCands
+  forM_ (M.toList cands) $ \case
+    (x, [b]) -> mkGlobalIdent (nameToIdent b) >>= addRename (nameToIdent x)
+    (x, _) -> addInitStmt $ WGSL.DeclareVar (memSelector x) (WGSL.Prim WGSL.Int32)
+
+-- | The selector variable of a memory variable.
+memSelector :: VName -> WGSL.Ident
+memSelector x = nameToIdent x <> "_sel"
+
+-- | The memory a statement accesses (reads, writes, copies, atomics).
+accessedMems :: Code ImpGPU.KernelOp -> [VName]
+accessedMems (Write mem _ _ _ _ _) = [mem]
+accessedMems (Read _ mem _ _ _ _) = [mem]
+accessedMems (Copy _ _ (dst, _) _ (src, _) _) = [dst, src]
+accessedMems (Op (ImpGPU.Atomic _ op)) = [atomicOpArray op]
+accessedMems (Op (ImpGPU.UniformRead _ mem _ _ _)) = [mem]
+accessedMems _ = []
+
+-- | A memory access through memory variables with selectors: the statement
+-- translated once per binding the first such variable can name (that
+-- variable renamed to the binding), under a test of its selector, the last
+-- candidate the final @else@ (the selector always holds one of them).
+genMemAccess :: Code ImpGPU.KernelOp -> KernelM WGSL.Stmt
+genMemAccess stm = do
+  sel <- gets ksMemSelect
+  case filter (`S.member` sel) (nubOrd (accessedMems stm)) of
+    [] -> genAccessStm stm
+    x : _ -> do
+      case stm of
+        Op ImpGPU.UniformRead {} ->
+          compilerLimitation $
+            "WebGPU backend cannot read uniformly (workgroupUniformLoad) through the memory variable " <> prettyText x <> ", which names one of several bindings at run time."
+        _ -> pure ()
+      cands <- gets $ M.findWithDefault [] x . ksMemCands
+      ids <- gets ksBindingIds
+      let x' = nameToIdent x
+      old <- gets $ M.lookup x' . ksNameReplacements
+      branches <- forM cands $ \b -> do
+        b' <- mkGlobalIdent (nameToIdent b)
+        modify $ \s ->
+          s
+            { ksMemSelect = S.delete x (ksMemSelect s),
+              ksNameReplacements = M.insert x' b' (ksNameReplacements s)
+            }
+        code <- genMemAccess stm
+        modify $ \s ->
+          s
+            { ksMemSelect = S.insert x (ksMemSelect s),
+              ksNameReplacements = M.alter (const old) x' (ksNameReplacements s)
+            }
+        pure (M.findWithDefault 0 b ids, code)
+      let test i = WGSL.BinOpExp "==" (WGSL.VarExp (memSelector x)) (WGSL.IntExp i)
+          chain [] = WGSL.Skip
+          chain [(_, code)] = code
+          chain ((i, code) : rest) = WGSL.If (test i) code (chain rest)
+      pure $ chain branches
 
