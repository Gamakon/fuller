--- | Translate code nested one level deeper in the kernel's control flow.
-underControl :: KernelM a -> KernelM a
-underControl m = do
-  modify $ \s -> s {ksControlDepth = ksControlDepth s + 1}
-  x <- m
-  modify $ \s -> s {ksControlDepth = ksControlDepth s - 1}
