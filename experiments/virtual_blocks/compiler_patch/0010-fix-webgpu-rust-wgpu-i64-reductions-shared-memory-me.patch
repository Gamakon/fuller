-        callText = funName fname <> "(" <> T.intercalate ", " ("ctx" : "&st" : inArgs) <> ")?"
+        -- A scalar argument converted to the internal type is a cast
+        -- (`(a0 as i64)`, a u64 entry argument): bare, or rustc's
+        -- unused_parens fires on the argument.
+        callText = funName fname <> "(" <> T.intercalate ", " ("ctx" : "&st" : map bare inArgs) <> ")?"
     line $ (if null outs then "" else "let r = ") <> callText <> ";"
     let dimExp (Constant (IntValue v)) = pure $ showT (valueIntegral v :: Integer) <> "i64"
         dimExp (Constant v) = compilerLimitation $ "The rust-wgpu backend found a non-integer dimension " <> prettyText v
@@ -885,10 +888,10 @@ genEntry fname fun ep = do
     case result of
       TransparentValue vd -> do
         e <- resultOf vd
-        line $ "Ok(" <> e <> ")"
+        line $ "Ok(" <> bare e <> ")"
       OpaqueValue oname vds -> do
         es <- mapM resultOf vds
-        line $ "Ok(rt::Opaque::new(" <> strLit (nameToText oname) <> ", vec![" <> T.intercalate ", " (map (\e -> "rt::Value::from(" <> e <> ")") es) <> "]))"
+        line $ "Ok(rt::Opaque::new(" <> strLit (nameToText oname) <> ", vec![" <> T.intercalate ", " (map (\e -> "rt::Value::from(" <> bare e <> ")") es) <> "]))"
   line "}"
   -- The dynamic adapter.
   let dname = "dyn_" <> unique (nameToText (entryPointName ep))
