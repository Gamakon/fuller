diff --git a/tests/webgpu/f32_i64_conversions.fut b/tests/webgpu/f32_i64_conversions.fut
new file mode 100644
index 000000000..4b6477810
--- /dev/null
+++ b/tests/webgpu/f32_i64_conversions.fut
@@ -0,0 +1,31 @@
+-- f32 <-> i64/u64 conversions, rounded to nearest even and truncated towards
+-- zero as C converts. u64->f32 multiplied the high word by 2e32 (2*10^32), not
+-- 2^32, and f32->i64 was not implemented.
+
+-- ==
+-- entry: u64_to_f32
+-- input { [0u64, 1u64, 16777217u64, 4294967296u64, 4294967297u64, 0x0100000080000001u64, 0x0100000080000000u64, 0xFFFFFFFFFFFFFFFFu64] }
+-- output { [0f32, 1f32, 16777216f32, 4294967296f32, 4294967296f32, 72057596037927936f32, 72057594037927936f32, 18446744073709551616f32] }
+
+entry u64_to_f32 (xs: []u64) : []f32 = map f32.u64 xs
+
+-- ==
+-- entry: i64_to_f32
+-- input { [0i64, -1i64, -2147483649i64, -9223372036854775808i64, 9223372036854775807i64, -16777217i64] }
+-- output { [0f32, -1f32, -2147483648f32, -9223372036854775808f32, 9223372036854775808f32, -16777216f32] }
+
+entry i64_to_f32 (xs: []i64) : []f32 = map f32.i64 xs
+
+-- ==
+-- entry: f32_to_i64
+-- input { [0f32, 1.75f32, -1.75f32, 4294967296f32, -6442450944f32, 1e18f32, -2147483648f32] }
+-- output { [0i64, 1i64, -1i64, 4294967296i64, -6442450944i64, 999999984306749440i64, -2147483648i64] }
+
+entry f32_to_i64 (xs: []f32) : []i64 = map i64.f32 xs
+
+-- ==
+-- entry: f32_to_u64
+-- input { [0f32, 1.75f32, 4294967296f32, 1.8e19f32] }
+-- output { [0u64, 1u64, 4294967296u64, 18000000404716257280u64] }
+
+entry f32_to_u64 (xs: []f32) : []u64 = map u64.f32 xs
diff --git a/tests/webgpu/i64_reduce.fut b/tests/webgpu/i64_reduce.fut
new file mode 100644
index 000000000..8b5726adf
--- /dev/null
+++ b/tests/webgpu/i64_reduce.fut
@@ -0,0 +1,26 @@
+-- A non-segmented i64 reduction: each block stores its partial result with an
+-- atomic write, which WGSL has no 64-bit type for (it failed to compile with
+-- "Atomics not supported for values of type IntType Int64").
+
+-- ==
+-- entry: sum_i64
+-- input { [1i64, -2i64, 0x100000000i64, 0x7FFFFFFF00000000i64] }
+-- output { 0x7FFFFFFFFFFFFFFFi64 }
+-- compiled random input { [100000]i64 } auto output
+
+entry sum_i64 (xs: []i64) : i64 = i64.sum xs
+
+-- ==
+-- entry: sum_u64
+-- input { [0xFFFFFFFFFFFFFFFFu64, 2u64] }
+-- output { 1u64 }
+-- compiled random input { [100000]u64 } auto output
+
+entry sum_u64 (xs: []u64) : u64 = u64.sum xs
+
+-- ==
+-- entry: count_i64
+-- input { [1f32, 5f32, 3f32] 2f32 }
+-- output { 2i64 }
+
+entry count_i64 (xs: []f32) (t: f32) : i64 = i64.sum (map (\x -> i64.bool (x >= t)) xs)
-- 
