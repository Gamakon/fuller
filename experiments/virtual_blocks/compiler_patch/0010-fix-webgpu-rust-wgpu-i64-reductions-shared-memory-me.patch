 genAtomicOp f t dest mem i e = do
-  mem' <- getIdent mem
+  mem' <- memIdent t mem
   shared <- isShared mem'
   i' <- indexExp i
   v' <- genWGSLExp e
@@ -810,9 +823,10 @@ genSharedDecl name = do
   moduleName <- mkGlobalIdent name'
   sizeName <- mkGlobalIdent $ name' <> "_size"
 
-  maybeElemPrimType <- findSingleMemoryType name
-  case maybeElemPrimType of
-    Just elemPrimType@(_, atomic, _) -> do
+  types <- sharedTypes name
+  case types of
+    [] -> pure $ WGSL.Comment $ "discard declare_shared: " <> name'
+    [elemPrimType@(_, atomic, _)] -> do
       let bufType =
             wgslSharedBufferType
               elemPrimType
@@ -823,8 +837,40 @@ genSharedDecl name = do
       when atomic $ addAtomicMem moduleName
       addRename name' moduleName
       pure $ WGSL.Comment $ "declare_shared: " <> name'
-    Nothing ->
-      pure $ WGSL.Comment $ "discard declare_shared: " <> name'
+    _ -> do
+      -- One workgroup array a type, each the allocation's full size: the
+      -- accesses at a type use that type's array ('memIdent'). The merged
+      -- allocations have disjoint lifetimes, so no value passes between
+      -- the arrays; the cost is the shared memory the merging had saved.
+      views <- forM types $ \elemPrimType@(t, _, _) -> do
+        typed <- mkGlobalIdent $ sharedTypedName name' t
+        let typedSize = typed <> "_size"
+        addOverride typedSize (WGSL.Prim WGSL.Int32) (Just $ WGSL.IntExp 0)
+        addDecl $
+          WGSL.VarDecl [] WGSL.Workgroup typed $
+            wgslSharedBufferType elemPrimType (Just $ WGSL.VarExp typedSize)
+        pure (t, typed)
+      addRename name' moduleName
+      modify $ \s -> s {ksTypedShared = M.insert moduleName (M.fromList views) (ksTypedShared s)}
+      pure $ WGSL.Comment $ "declare_shared: " <> name' <> " at " <> prettyText (map fst views)
+
+-- | The name of a shared allocation's workgroup array at one element type.
+sharedTypedName :: WGSL.Ident -> PrimType -> WGSL.Ident
+sharedTypedName name' t = name' <> "_" <> prettyText t
+
+-- | The element types a shared allocation is accessed at. Several types are
+-- allowed only without atomic accesses.
+sharedTypes :: VName -> KernelM [(PrimType, Bool, Signedness)]
+sharedTypes name = do
+  types <- findMemoryTypes name
+  case nubOrd (map (\(t, _, _) -> t) types) of
+    [] -> pure []
+    [_] -> maybe [] pure <$> findSingleMemoryType name
