From ed2bc96bb316053c2524fc446235cb77cad176af Mon Sep 17 00:00:00 2001
From: futhark-rust-backend <none>
Date: Sun, 1 Nov 2026 21:21:44 +0000
Subject: [PATCH] fix(webgpu, rust-wgpu): i64 reductions, shared memory merged
 across element types, f32<->i64 conversions, u64 entry arguments

- An atomic write is a plain write in WGSL, so its buffer needs an atomic type
  only where WGSL has one: a non-segmented i64/u64 reduction (each block's
  partial result is stored by an atomic write) failed with "Atomics not
  supported for values of type IntType Int64".
- A shared allocation accessed at several element types (memory block merging
  gives disjoint-lifetime allocations one block whatever their types) is one
  workgroup array a type; it failed with "Buffer used at multiple types",
  which now names the buffer and the types.
- f32->i64 and f32->u64 (FPToSI/FPToUI) were not implemented (the WGSL called
  not_implemented(...)); u64->f32 scaled the high word by 2e32 (2*10^32), not
  2^32; i64->f32 was wrong for negatives below -2^31. All four now convert as
  C does (round to nearest even; truncation towards zero).
- The rust-wgpu entry wrapper passed a converted scalar argument as
  "(a0 as i64)", which rustc's unused_parens rejects under -D warnings (a u64
  entry argument); arguments and scalar results are now bare.

Tests: tests/webgpu/i64_reduce.fut, tests/webgpu/f32_i64_conversions.fut
(pass on the c backend; the GPU check is fuller's).
---
 rts/wgsl/scalar64.wgsl                   |  47 +++++++--
 src/Futhark/CodeGen/Backends/RustWGPU.hs |   9 +-
 src/Futhark/CodeGen/ImpGen/WebGPU.hs     | 124 +++++++++++++++++------
 tests/webgpu/f32_i64_conversions.fut     |  31 ++++++
 tests/webgpu/i64_reduce.fut              |  26 +++++
 5 files changed, 193 insertions(+), 44 deletions(-)
 create mode 100644 tests/webgpu/f32_i64_conversions.fut
 create mode 100644 tests/webgpu/i64_reduce.fut

diff --git a/rts/wgsl/scalar64.wgsl b/rts/wgsl/scalar64.wgsl
index cc7b24bcd..af66104cb 100644
--- a/rts/wgsl/scalar64.wgsl
+++ b/rts/wgsl/scalar64.wgsl
@@ -233,14 +233,12 @@ fn i64_to_f16(a: i64) -> f16 {
   return f16(a.x);
 }
 
-// TODO: This is not accurate to a real i64->f32 conversion, but hopefully good
-// enough for now.
+// A two's complement i64 to f32, rounded to nearest even (C's conversion):
+// the magnitude through u64_to_f32, then the sign. -2^63 negates to itself,
+// whose bits read as the u64 2^63, its magnitude.
 fn i64_to_f32(a: i64) -> f32 {
-  if (a.y == -1) {
-    if (a.x > 0) { return -f32(a.x); }
-    else { return f32(a.x); }
-  }
-  return f32(bitcast<u32>(a.x)) + f32(a.y) * 2e32f;
+  if (a.y < 0) { return -u64_to_f32(neg_i64(a)); }
+  return u64_to_f32(a);
 }
 
 fn u64_to_f16(a: i64) -> f16 {
@@ -248,8 +246,41 @@ fn u64_to_f16(a: i64) -> f16 {
   return f16(bitcast<u32>(a.x));
 }
 
+// A u64 to f32, rounded to nearest even (C's conversion). Under 2^32 it is
+// WGSL's u32 conversion. Above, the top 32 bits from the leading one are
+// converted, with every lower bit folded into their lowest bit (a sticky bit:
+// the rounding position is bit 7 of the 32, so the sticky bit decides only
+// ties, as the dropped bits would), and scaled back by a power of two (exact).
+// (It was f32(lo) + f32(hi) * 2e32, which is 2*10^32, not 2^32.)
 fn u64_to_f32(a: i64) -> f32 {
-  return f32(bitcast<u32>(a.x)) + f32(bitcast<u32>(a.y)) * 2e32f;
+  let lo = bitcast<u32>(a.x);
+  let hi = bitcast<u32>(a.y);
+  if (hi == 0u) { return f32(lo); }
+  let n = countLeadingZeros(hi);
+  var top = hi;
+  var sticky = lo;
+  if (n > 0u) {
+    top = (hi << n) | (lo >> (32u - n));
+    sticky = lo << n;
+  }
+  if (sticky != 0u) { top = top | 1u; }
+  return ldexp(f32(top), i32(32u - n));
+}
+
+// An f32 to i64, truncated towards zero (C's conversion, for values in range;
+// NaN gives 0). The magnitude's high word is m / 2^32 truncated, exact as a
+// power-of-two scale; its low word is the remainder, exactly representable.
+fn f32_to_u64(a: f32) -> i64 {
+  let m = max(a, 0.0f);
+  let hi = u32(m * 2.3283064365386963e-10f);
+  let lo = u32(m - f32(hi) * 4294967296.0f);
+  return i64(bitcast<i32>(lo), bitcast<i32>(hi));
+}
+
+fn f32_to_i64(a: f32) -> i64 {
+  let v = f32_to_u64(abs(a));
+  if (a < 0.0f) { return neg_i64(v); }
+  return v;
 }
 
 // End of scalar64.wgsl
