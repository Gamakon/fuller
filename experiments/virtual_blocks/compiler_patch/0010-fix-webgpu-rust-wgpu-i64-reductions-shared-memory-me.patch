+      | any (\(_, a, _) -> a) types ->
+          compilerLimitation $
+            "WebGPU backend cannot access the shared allocation " <> prettyText name <> " atomically at several types: " <> prettyText prims
+      | otherwise -> pure [(t, False, Signed) | t <- prims]
 
