#[noinline]
def kernel [n] (k: i32) (is: [n]i32) (vs: [n]i32) : [i64.i32 k]i32 =
  let k = i64.i32 k
  let zeros_k = replicate k 0i32
  let zeros_n = replicate n 0i32
  in map2 i32.min (tabulate k (\j1 -> (i32.abs (((hist (+) 0i32 k (map i64.i32 (is)) (vs))[(j1)]) - ((hist (+) 0i32 k (map i64.i32 (is)) (replicate n (i32.max (i32.minimum (is)) (i32.min (i32.maximum (tabulate n (\j2 -> ((vs)[(j2)])))) ((is)[(i64.max 0 (i64.min (n - 1) (i64.i32 (i32.i64 (j1)))))])))))[(j1)]))))) (map2 i32.min (hist i32.min i32.highest k (map i64.i32 (tabulate n (\j1 -> ((vs)[(j1)])))) (vs)) (hist i32.min i32.highest k (map i64.i32 (tabulate n (\j1 -> (i32.maximum (vs))))) (loop (s1: [n]i32) = (replicate n (i32.maximum (tabulate n (\j1 -> (if (((vs)[(j1)]) - ((is)[(j1)])) < 0i32 then (1i32) else (0i32)))))) for i1 < n do (tabulate n (\j2 -> ((((s1)[(i64.max 0 ((j2) - 1))]) + ((vs)[(j2)])) - (1i32)))))))

