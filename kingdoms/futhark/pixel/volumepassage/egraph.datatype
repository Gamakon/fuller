; The pixel family's e-graph datatype over the rows, generated by gen_tables.py (pixel_rows.py).
; One sort per data type, one constructor per symbol.

(sort PImage)
(sort PBlk)
(sort PBody1)
(sort PBody3)
(sort PBody5)
(sort PF32)
(sort PCount)

(constructor XImage (PBlk) PImage)
(constructor XImageBlack () PImage)
(constructor XLetBlk (PF32 PBlk) PBlk)
(constructor XBlock1Blk (PBody1 PBlk) PBlk)
(constructor XBlock3Blk (PBody3 PBlk) PBlk)
(constructor XBlock5Blk (PBody5 PBlk) PBlk)
(constructor XLoop1Blk (PF32 PCount PBody1 PBlk) PBlk)
(constructor XLoop3Blk (PF32 PF32 PF32 PCount PBody3 PBlk) PBlk)
(constructor XLoop5Blk (PF32 PF32 PF32 PF32 PF32 PCount PBody5 PBlk) PBlk)
(constructor XRgb (PF32 PF32 PF32) PBlk)
(constructor XBlack () PBlk)
(constructor XLetBody1 (PF32 PBody1) PBody1)
(constructor XBlock1Body1 (PBody1 PBody1) PBody1)
(constructor XBlock3Body1 (PBody3 PBody1) PBody1)
(constructor XBlock5Body1 (PBody5 PBody1) PBody1)
(constructor XLoop1Body1 (PF32 PCount PBody1 PBody1) PBody1)
(constructor XLoop3Body1 (PF32 PF32 PF32 PCount PBody3 PBody1) PBody1)
(constructor XLoop5Body1 (PF32 PF32 PF32 PF32 PF32 PCount PBody5 PBody1) PBody1)
(constructor XTupleBody1 (PF32) PBody1)
(constructor XZeroBody1 () PBody1)
(constructor XLetBody3 (PF32 PBody3) PBody3)
(constructor XBlock1Body3 (PBody1 PBody3) PBody3)
(constructor XBlock3Body3 (PBody3 PBody3) PBody3)
(constructor XBlock5Body3 (PBody5 PBody3) PBody3)
(constructor XLoop1Body3 (PF32 PCount PBody1 PBody3) PBody3)
(constructor XLoop3Body3 (PF32 PF32 PF32 PCount PBody3 PBody3) PBody3)
(constructor XLoop5Body3 (PF32 PF32 PF32 PF32 PF32 PCount PBody5 PBody3) PBody3)
(constructor XTupleBody3 (PF32 PF32 PF32) PBody3)
(constructor XZeroBody3 () PBody3)
(constructor XLetBody5 (PF32 PBody5) PBody5)
(constructor XBlock1Body5 (PBody1 PBody5) PBody5)
(constructor XBlock3Body5 (PBody3 PBody5) PBody5)
(constructor XBlock5Body5 (PBody5 PBody5) PBody5)
(constructor XLoop1Body5 (PF32 PCount PBody1 PBody5) PBody5)
(constructor XLoop3Body5 (PF32 PF32 PF32 PCount PBody3 PBody5) PBody5)
(constructor XLoop5Body5 (PF32 PF32 PF32 PF32 PF32 PCount PBody5 PBody5) PBody5)
(constructor XTupleBody5 (PF32 PF32 PF32 PF32 PF32) PBody5)
(constructor XZeroBody5 () PBody5)
(constructor XAdd (PF32 PF32) PF32)
(constructor XSub (PF32 PF32) PF32)
(constructor XMul (PF32 PF32) PF32)
(constructor XDiv (PF32 PF32) PF32)
(constructor XMax (PF32 PF32) PF32)
(constructor XMin (PF32 PF32) PF32)
(constructor XPow (PF32 PF32) PF32)
(constructor XMod (PF32 PF32) PF32)
(constructor XNeg (PF32) PF32)
(constructor XAbs (PF32) PF32)
(constructor XSqrt (PF32) PF32)
(constructor XSin (PF32) PF32)
(constructor XCos (PF32) PF32)
