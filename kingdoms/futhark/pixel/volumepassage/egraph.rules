; The pixel family's e-graph ruleset over the rows, generated by gen_tables.py (pixel_rows.py).
(ruleset futhark_pixel)

(rewrite (XAdd a b) (XAdd b a) :ruleset futhark_pixel)
(rewrite (XMul a b) (XMul b a) :ruleset futhark_pixel)
(rewrite (XMax a b) (XMax b a) :ruleset futhark_pixel)
(rewrite (XMin a b) (XMin b a) :ruleset futhark_pixel)
(rewrite (XSub a b) (XAdd a (XNeg b)) :ruleset futhark_pixel)
(rewrite (XNeg (XNeg a)) a :ruleset futhark_pixel)
(rewrite (XAbs (XNeg a)) (XAbs a) :ruleset futhark_pixel)
(rewrite (XMul a (CPF32 4)) (XAdd a a) :ruleset futhark_pixel)
(rewrite (XMul a (CPF32 1)) a :ruleset futhark_pixel)
(rewrite (XDiv a (CPF32 4)) (XMul a (CPF32 3)) :ruleset futhark_pixel)
(rewrite (XDiv a (CPF32 39)) (XMul a (CPF32 6)) :ruleset futhark_pixel)
