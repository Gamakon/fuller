; The shape kingdom's e-graph ruleset, generated by gen_tables.py.
(ruleset futhark_shape)

; `map` with the identity row function is the matrix (mat.n.n)
(rewrite (AMapRowsMatNN (FRowFnId) x) x :ruleset futhark_shape)
; `map2` with the identity binary row function is the first matrix (mat.n.n)
(rewrite (AMap2RowsMatNN (FRow2FnId) x y) x :ruleset futhark_shape)
; `transpose` is an involution (mat.n.n)
(rewrite (ATransposeMatNN (ATransposeMatNN x)) x :ruleset futhark_shape)

; `map` with the identity row function is the matrix (mat.n.m)
(rewrite (AMapRowsMatNM (FRowFnId) x) x :ruleset futhark_shape)
; `map2` with the identity binary row function is the first matrix (mat.n.m)
(rewrite (AMap2RowsMatNM (FRow2FnId) x y) x :ruleset futhark_shape)
; `transpose` is an involution (mat.n.m)
(rewrite (ATransposeMatMN (ATransposeMatNM x)) x :ruleset futhark_shape)

; `map` with the identity row function is the matrix (mat.n.p)
(rewrite (AMapRowsMatNP (FRowFnId) x) x :ruleset futhark_shape)
; `map2` with the identity binary row function is the first matrix (mat.n.p)
(rewrite (AMap2RowsMatNP (FRow2FnId) x y) x :ruleset futhark_shape)
; `transpose` is an involution (mat.n.p)
(rewrite (ATransposeMatPN (ATransposeMatNP x)) x :ruleset futhark_shape)

; `map` with the identity row function is the matrix (mat.m.n)
(rewrite (AMapRowsMatMN (FRowFnId) x) x :ruleset futhark_shape)
; `map2` with the identity binary row function is the first matrix (mat.m.n)
(rewrite (AMap2RowsMatMN (FRow2FnId) x y) x :ruleset futhark_shape)
; `transpose` is an involution (mat.m.n)
(rewrite (ATransposeMatNM (ATransposeMatMN x)) x :ruleset futhark_shape)

; `map` with the identity row function is the matrix (mat.m.m)
(rewrite (AMapRowsMatMM (FRowFnId) x) x :ruleset futhark_shape)
; `map2` with the identity binary row function is the first matrix (mat.m.m)
(rewrite (AMap2RowsMatMM (FRow2FnId) x y) x :ruleset futhark_shape)
; `transpose` is an involution (mat.m.m)
(rewrite (ATransposeMatMM (ATransposeMatMM x)) x :ruleset futhark_shape)

; `map` with the identity row function is the matrix (mat.m.p)
(rewrite (AMapRowsMatMP (FRowFnId) x) x :ruleset futhark_shape)
; `map2` with the identity binary row function is the first matrix (mat.m.p)
(rewrite (AMap2RowsMatMP (FRow2FnId) x y) x :ruleset futhark_shape)
; `transpose` is an involution (mat.m.p)
(rewrite (ATransposeMatPM (ATransposeMatMP x)) x :ruleset futhark_shape)

; `map` with the identity row function is the matrix (mat.p.n)
(rewrite (AMapRowsMatPN (FRowFnId) x) x :ruleset futhark_shape)
; `map2` with the identity binary row function is the first matrix (mat.p.n)
(rewrite (AMap2RowsMatPN (FRow2FnId) x y) x :ruleset futhark_shape)
; `transpose` is an involution (mat.p.n)
(rewrite (ATransposeMatNP (ATransposeMatPN x)) x :ruleset futhark_shape)

; `map` with the identity row function is the matrix (mat.p.m)
(rewrite (AMapRowsMatPM (FRowFnId) x) x :ruleset futhark_shape)
; `map2` with the identity binary row function is the first matrix (mat.p.m)
(rewrite (AMap2RowsMatPM (FRow2FnId) x y) x :ruleset futhark_shape)
; `transpose` is an involution (mat.p.m)
(rewrite (ATransposeMatMP (ATransposeMatPM x)) x :ruleset futhark_shape)

; `map` with the identity row function is the matrix (mat.p.p)
(rewrite (AMapRowsMatPP (FRowFnId) x) x :ruleset futhark_shape)
; `map2` with the identity binary row function is the first matrix (mat.p.p)
(rewrite (AMap2RowsMatPP (FRow2FnId) x y) x :ruleset futhark_shape)
; `transpose` is an involution (mat.p.p)
(rewrite (ATransposeMatPP (ATransposeMatPP x)) x :ruleset futhark_shape)

; the product of (mat.n.n) and (mat.n.n), transposed, is the product itself
(rewrite (ATransposeMatNN (AMatmulMatNNMatNN (ATransposeMatNN u) (ATransposeMatNN v))) (AMatmulMatNNMatNN v u) :ruleset futhark_shape)

; the product of (mat.n.n) and (mat.n.m), transposed, is the product itself
(rewrite (ATransposeMatMN (AMatmulMatMNMatNN (ATransposeMatNM u) (ATransposeMatNN v))) (AMatmulMatNNMatNM v u) :ruleset futhark_shape)

; the product of (mat.n.n) and (mat.n.p), transposed, is the product itself
(rewrite (ATransposeMatPN (AMatmulMatPNMatNN (ATransposeMatNP u) (ATransposeMatNN v))) (AMatmulMatNNMatNP v u) :ruleset futhark_shape)

; the product of (mat.n.m) and (mat.m.n), transposed, is the product itself
(rewrite (ATransposeMatNN (AMatmulMatNMMatMN (ATransposeMatMN u) (ATransposeMatNM v))) (AMatmulMatNMMatMN v u) :ruleset futhark_shape)

; the product of (mat.n.m) and (mat.m.m), transposed, is the product itself
(rewrite (ATransposeMatMN (AMatmulMatMMMatMN (ATransposeMatMM u) (ATransposeMatNM v))) (AMatmulMatNMMatMM v u) :ruleset futhark_shape)

; the product of (mat.n.m) and (mat.m.p), transposed, is the product itself
(rewrite (ATransposeMatPN (AMatmulMatPMMatMN (ATransposeMatMP u) (ATransposeMatNM v))) (AMatmulMatNMMatMP v u) :ruleset futhark_shape)

