; the product of (mat.m.m) and (mat.m.n), transposed, is the product itself
(rewrite (ATransposeMatNM (AMatmulMatNMMatMM (ATransposeMatMN u) (ATransposeMatMM v))) (AMatmulMatMMMatMN v u) :ruleset futhark_shape)

; the product of (mat.m.m) and (mat.m.m), transposed, is the product itself
(rewrite (ATransposeMatMM (AMatmulMatMMMatMM (ATransposeMatMM u) (ATransposeMatMM v))) (AMatmulMatMMMatMM v u) :ruleset futhark_shape)

; the product of (mat.m.m) and (mat.m.p), transposed, is the product itself
(rewrite (ATransposeMatPM (AMatmulMatPMMatMM (ATransposeMatMP u) (ATransposeMatMM v))) (AMatmulMatMMMatMP v u) :ruleset futhark_shape)

; the product of (mat.m.p) and (mat.p.n), transposed, is the product itself
(rewrite (ATransposeMatNM (AMatmulMatNPMatPM (ATransposeMatPN u) (ATransposeMatMP v))) (AMatmulMatMPMatPN v u) :ruleset futhark_shape)

; the product of (mat.m.p) and (mat.p.m), transposed, is the product itself
(rewrite (ATransposeMatMM (AMatmulMatMPMatPM (ATransposeMatPM u) (ATransposeMatMP v))) (AMatmulMatMPMatPM v u) :ruleset futhark_shape)

; the product of (mat.m.p) and (mat.p.p), transposed, is the product itself
(rewrite (ATransposeMatPM (AMatmulMatPPMatPM (ATransposeMatPP u) (ATransposeMatMP v))) (AMatmulMatMPMatPP v u) :ruleset futhark_shape)

; the product of (mat.p.n) and (mat.n.n), transposed, is the product itself
(rewrite (ATransposeMatNP (AMatmulMatNNMatNP (ATransposeMatNN u) (ATransposeMatPN v))) (AMatmulMatPNMatNN v u) :ruleset futhark_shape)

; the product of (mat.p.n) and (mat.n.m), transposed, is the product itself
(rewrite (ATransposeMatMP (AMatmulMatMNMatNP (ATransposeMatNM u) (ATransposeMatPN v))) (AMatmulMatPNMatNM v u) :ruleset futhark_shape)

; the product of (mat.p.n) and (mat.n.p), transposed, is the product itself
(rewrite (ATransposeMatPP (AMatmulMatPNMatNP (ATransposeMatNP u) (ATransposeMatPN v))) (AMatmulMatPNMatNP v u) :ruleset futhark_shape)

; the product of (mat.p.m) and (mat.m.n), transposed, is the product itself
(rewrite (ATransposeMatNP (AMatmulMatNMMatMP (ATransposeMatMN u) (ATransposeMatPM v))) (AMatmulMatPMMatMN v u) :ruleset futhark_shape)

