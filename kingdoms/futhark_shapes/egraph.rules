(rewrite (ATransposeMatNN (AMatmulMatNPMatPN (ATransposeMatPN u) (ATransposeMatNP v))) (AMatmulMatNPMatPN v u) :ruleset futhark_shape)

; the product of (mat.n.p) and (mat.p.m), transposed, is the product itself
(rewrite (ATransposeMatMN (AMatmulMatMPMatPN (ATransposeMatPM u) (ATransposeMatNP v))) (AMatmulMatNPMatPM v u) :ruleset futhark_shape)

; the product of (mat.n.p) and (mat.p.p), transposed, is the product itself
(rewrite (ATransposeMatPN (AMatmulMatPPMatPN (ATransposeMatPP u) (ATransposeMatNP v))) (AMatmulMatNPMatPP v u) :ruleset futhark_shape)

; the product of (mat.m.n) and (mat.n.n), transposed, is the product itself
