    10	/// The `powers` ruleset.
    11	pub const POWERS_RULESET: &str = r#"
    12	(ruleset powers)
    13	
    14	; ---- Pow basics (SymPy core/power.py Pow.eval) ----
    15	; x^0 = 1
    16	(rewrite (Pow x (Num 0.0)) (Num 1.0) :ruleset powers)
    17	; x^1 = x
    18	(rewrite (Pow x (Num 1.0)) x :ruleset powers)
    19	; x^2 and x^3 normalise to the dedicated constructors (cheaper, evaluable)
    20	(rewrite (Pow x (Num 2.0)) (Pow2 x) :ruleset powers)
    21	(rewrite (Pow x (Num 3.0)) (Pow3 x) :ruleset powers)
    22	; 1^x = 1
    23	(rewrite (Pow (Num 1.0) x) (Num 1.0) :ruleset powers)
    24	
    25	; ---- exponent arithmetic (SymPy powsimp.py: x^a * x^b = x^(a+b)) ----
    26	; CAUTION: these are UNSOUND to run unbounded in a pure-rewrite e-graph.
    27	; egglog does not constant-fold the exponent, so `(Add a b)` on the RHS builds
    28	; ever-taller unevaluated Num towers — combined with `x^2 -> Pow2 x` etc. this
    29	; never reaches fixpoint and the e-graph grows without bound (it pegged the CPU
    30	; in testing). They are therefore DISABLED until exponent constant-folding
    31	; lands (a Phase-1.4-style evaluator pass that folds `(Add 2.0 1.0) -> 3.0`
    32	; before re-applying), at which point they terminate. Tracked, not shipped.
    33	;
    34	; (rewrite (Mul (Pow x a) (Pow x b)) (Pow x (Add a b)) :ruleset powers)
    35	; (rewrite (Mul (Pow x a) x)         (Pow x (Add a (Num 1.0))) :ruleset powers)
    36	; (rewrite (Mul x (Pow x a))         (Pow x (Add a (Num 1.0))) :ruleset powers)
    37	; (rewrite (Pow (Pow x a) b)         (Pow x (Mul a b)) :ruleset powers)
    38	; (rewrite (Div (Pow x a) (Pow x b)) (Pow x (Sub a b)) :ruleset powers)
    39	
    40	; ---- log / exp (SymPy exponential.py); GUARDED on positivity ----
    41	; log(exp x) = x  — sound for all real x (exp x > 0, log defined)
    42	(rewrite (Log (Exp x)) x :ruleset powers)
    43	; exp(log x) = x  — only where x > 0
    44	(rewrite (Exp (Log x)) x :when ((is-positive x)) :ruleset powers)
    45	; log(a*b) = log a + log b  — only where a > 0 and b > 0
    46	(rewrite (Log (Mul a b)) (Add (Log a) (Log b))
    47	    :when ((is-positive a) (is-positive b)) :ruleset powers)
    48	; log(x^n) = n * log x  — only where x > 0
    49	(rewrite (Log (Pow x n)) (Mul n (Log x)) :when ((is-positive x)) :ruleset powers)
    50	; exp(a) * exp(b) = exp(a+b)  — sound for all reals
    51	(rewrite (Mul (Exp a) (Exp b)) (Exp (Add a b)) :ruleset powers)
    52	
    53	; sqrt(p)^2 = p, GUARDED on p > 0. Unguarded it is unsound in the real domain
    54	; (for p < 0 the left side is NaN and the right side is p). The same rule
    55	; lives in `distribute`, but distribute cannot be co-saturated with the live
    56	; rules, so the simplifier never saw it.
    57	(rewrite (Pow2 (Sqrt p)) p :when ((is-positive p)) :ruleset powers)
    58	"#;
    59	
    60	#[cfg(test)]
    65	
    66	/// Domain-guard relations shared across rule modules.
    67	///
    68	/// egglog 2.0 cannot guard on a free variable's sign directly, so we carry
    69	/// domain facts as relations a rule can require via `:when`:
    70	///   * `(is-positive m)` — `m` is known > 0  (guards log/exp identities)
    71	///   * `(is-nonzero  m)` — `m` is known != 0  (guards div/inv identities)
    72	///
    73	/// Facts are introduced by *propagation* (e.g. `Exp x` is always positive;
    74	/// a product/quotient of positives is positive; positive implies nonzero;
    75	/// a nonzero numeric literal is nonzero) and by the caller asserting a fact
    76	/// for a specific node (e.g. `(is-nonzero (Var "x"))` when the engine knows a
    77	/// variable's domain). A bare free variable is NOT assumed nonzero/positive —
    78	/// guarded rules conservatively do not fire on it, which is the sound default.
    79	///
    80	/// The propagation rules live in the named `guards` ruleset. IMPORTANT: egglog
    81	/// only runs NAMED rulesets that a schedule mentions — a rule without a
    82	/// `:ruleset` tag lands in the default ruleset, which `(run algebra)` etc.
    83	/// never execute. Every schedule in this crate therefore includes `guards` in
    84	/// its combined ruleset (or runs it alongside); a schedule that forgets it
    85	/// gets no derived facts and the guarded rules silently never fire.
    86	pub const GUARD_RELATIONS: &str = r#"
    87	(relation is-positive (Math))
    88	(relation is-nonzero (Math))
    89	(ruleset guards)
    90	
    91	; Exp is positive on all reals -> seeds the log/exp domain.
    92	(rule ((= e (Exp x))) ((is-positive e) (is-nonzero e)) :ruleset guards)
    93	; positivity implies non-zero.
    94	(rule ((is-positive m)) ((is-nonzero m)) :ruleset guards)
    95	; product / quotient of positives is positive.
    96	(rule ((is-positive a) (is-positive b) (= m (Mul a b))) ((is-positive m)) :ruleset guards)
    97	(rule ((is-positive a) (is-positive b) (= m (Div a b))) ((is-positive m)) :ruleset guards)
    98	; numeric literals carry their own sign: a positive literal is positive, a
    99	; negative one is at least nonzero (both unlock the guarded cancellations for
   100	; constant denominators).
   101	(rule ((= e (Num n)) (> n 0.0)) ((is-positive e)) :ruleset guards)
   102	(rule ((= e (Num n)) (< n 0.0)) ((is-nonzero e)) :ruleset guards)
   103	; positivity flows through the power/root/reciprocal ops (b > 0 => b^p > 0 for
   104	; any real p; x != 0 => x^2 > 0; |x| > 0 iff x != 0). These are what let a
   105	; caller-asserted `is-positive a` reach Abs(Pow a p) and shed the Abs — the
   106	; SRBench exact-recovery killer.
   107	(rule ((is-positive b) (= e (Pow b p))) ((is-positive e)) :ruleset guards)
   108	(rule ((is-nonzero x) (= e (Pow2 x))) ((is-positive e)) :ruleset guards)
   109	(rule ((is-positive x) (= e (Pow3 x))) ((is-positive e)) :ruleset guards)
   110	(rule ((is-positive x) (= e (Sqrt x))) ((is-positive e)) :ruleset guards)
   111	(rule ((is-positive x) (= e (Inv x))) ((is-positive e)) :ruleset guards)
   112	(rule ((is-nonzero x) (= e (Abs x))) ((is-positive e)) :ruleset guards)
   113	; ProtectedExp is exp(x) or +inf: positive on the same terms as Exp above.
   114	(rule ((= e (ProtectedExp x))) ((is-positive e) (is-nonzero e)) :ruleset guards)
   115	; non-zero flows through product, quotient, reciprocal and negation. Without
   116	; these a fact dies one level up and the guarded reciprocal rules never chain.
   117	(rule ((is-nonzero a) (is-nonzero b) (= m (Mul a b))) ((is-nonzero m)) :ruleset guards)
   118	(rule ((is-nonzero a) (is-nonzero b) (= m (Div a b))) ((is-nonzero m)) :ruleset guards)
   119	(rule ((is-nonzero x) (= m (Inv x))) ((is-nonzero m)) :ruleset guards)
   120	(rule ((is-nonzero x) (= m (Neg x))) ((is-nonzero m)) :ruleset guards)
   121	
   122	; ---- is-nonneg: the value is never in [-inf, 0). NaN is allowed — Abs is the
   123	; identity on NaN too, so it is never a counterexample. Unlike is-positive this
   124	; has no underflow caveat (Exp underflowing to 0.0 is still >= 0), and it needs
   125	; no caller fact: Pow2 / Abs / Sqrt / Exp seed it structurally. Mined from the
   126	; hall of fame: 41 stored expressions carry an Abs over such an argument, 16 of
   127	; them through shapes no fixed list of Abs(X) rewrites reaches.
   128	(relation is-nonneg (Math))
   129	; seeds: >= 0 (or NaN) on every input
   130	(rule ((= e (Pow2 x)))          ((is-nonneg e)) :ruleset guards)
   131	(rule ((= e (Abs x)))           ((is-nonneg e)) :ruleset guards)
   132	(rule ((= e (Sqrt x)))          ((is-nonneg e)) :ruleset guards)
   133	(rule ((= e (ProtectedSqrt x))) ((is-nonneg e)) :ruleset guards)
   134	(rule ((= e (Exp x)))           ((is-nonneg e)) :ruleset guards)
   135	(rule ((= e (ProtectedExp x)))  ((is-nonneg e)) :ruleset guards)
   136	(rule ((= e (Num n)) (>= n 0.0)) ((is-nonneg e)) :ruleset guards)
   137	(rule ((is-positive m))         ((is-nonneg m)) :ruleset guards)
   138	; propagation: sign-preserving ops over nonneg operands
   139	(rule ((is-nonneg a) (is-nonneg b) (= m (Mul a b)))          ((is-nonneg m)) :ruleset guards)
   140	(rule ((is-nonneg a) (is-nonneg b) (= m (Add a b)))          ((is-nonneg m)) :ruleset guards)
   141	(rule ((is-nonneg a) (is-nonneg b) (= m (Div a b)))          ((is-nonneg m)) :ruleset guards)
   142	(rule ((is-nonneg a) (is-nonneg b) (= m (ProtectedDiv a b))) ((is-nonneg m)) :ruleset guards)
   143	(rule ((is-nonneg x) (= e (Pow3 x)))         ((is-nonneg e)) :ruleset guards)
   144	(rule ((is-nonneg x) (= e (Inv x)))          ((is-nonneg e)) :ruleset guards)
   145	(rule ((is-nonneg x) (= e (ProtectedInv x))) ((is-nonneg e)) :ruleset guards)
   146	(rule ((is-nonneg x) (= e (Tanh x)))         ((is-nonneg e)) :ruleset guards)
   147	(rule ((is-nonneg b) (= e (Pow b p)))        ((is-nonneg e)) :ruleset guards)
   148	"#;
   149	
   150	/// Build a fresh e-graph with the `Math` datatype loaded (no rules yet).
   690	/// rewrite used is an EQUIVALENCE (conditional ones fire only on the
   691	/// `positive_vars` / `nonzero_vars` the caller asserts), so every term in the
   692	/// e-class computes the same function and choosing among them by node count is
   693	/// a purely structural decision: nothing is evaluated and nothing is scored.
   694	/// Smaller is better, and that is the whole criterion.
   695	///
   696	/// It is bounded where `simplify` is not. `simplify` tries factoring,
   697	/// cancellation and trig rewriting (futrig) with no limit; a fit on the UCI
   698	/// power plant data spent 2h40m in it against a 30-minute budget. Here each
   699	/// pass is a fixed number of saturation steps, and passes alternate rule
   700	/// families — algebra+powers, then rational — each in its OWN e-graph,
   701	/// because those families explode when saturated together. A pass's result is
   702	/// taken only if it is strictly smaller, so the size never grows and the loop
   703	/// ends at the first round that shrinks nothing (or at
   704	/// [`SMALLEST_FORM_MAX_ROUNDS`]).
   705	///
   706	/// `inputs` names the data columns. It matters only for constant folding: a
   707	/// column called `c` is a variable, not the speed of light.
   708	///
   709	/// `denoise` cannot serve this purpose: with no rows it returns its input
   710	/// untouched.
   711	pub fn smallest_form(
   712	    input: &str,
   713	    inputs: &[String],
   714	    positive_vars: &[String],
   715	    nonzero_vars: &[String],
   716	) -> Result<SmallestForm, String> {
   717	    let input_cost = cost_of(input);
   718	    if input_cost == 0 {
   719	        return Err(format!("could not parse {input:?}"));
   720	    }
   721	    let asserts = guard_asserts(positive_vars, nonzero_vars);
   722	    let (mut best, mut best_cost, mut rounds) = (input.to_string(), input_cost, 0);
   723	    // egglog does not fold f64 literals, and a gene is full of constant
   724	    // subtrees — exp(1/exp(sin(phi))) + sqrt2 is the number 2.859. Folding one
   725	    // needs the evaluator but NO data: a constant subtree has no variables.
   726	    // `inputs` keeps a data column that shares a constant's name out of it.
   727	    let fold = |best: &mut String, best_cost: &mut u64| {
   728	        if let Some(f) = fold_constant_subtrees_excluding(best, inputs) {
   729	            let c = cost_of(&f);
   730	            if c > 0 && c < *best_cost {
   731	                *best = f;
   732	                *best_cost = c;
   733	            }
   734	        }
   735	    };
