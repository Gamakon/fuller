     2	//!
     3	//! These are the BRIEF.md rules 1-5: directional rewrites that always shrink
     4	//! or preserve, safe to run inside saturation. NO bare commutativity or
     5	//! associativity rewrites — egglog handles operand symmetry via e-class
     6	//! merging, and encoding it as a rewrite blows up saturation (the trap the
     7	//! Phase 1.0 calibration surfaced). Because we don't assume commutativity, the
     8	//! identity rules are written for BOTH operand orders explicitly where the
     9	//! literal can sit on either side.
    10	//!
    11	//! Each rule is stated as its math identity, then the egglog `rewrite`.
    12	
    13	/// The `algebra` ruleset: rules 1-5 from BRIEF.md.
    14	pub const ALGEBRA_RULESET: &str = r#"
    15	(ruleset algebra)
    16	
    17	; ---- Rule 2: multiplicative identity  (x * 1) = x , (1 * x) = x ----
    18	(rewrite (Mul x (Num 1.0)) x :ruleset algebra)
    19	(rewrite (Mul (Num 1.0) x) x :ruleset algebra)
    20	; x / 1 = x, and -1 * x = -x. Both EXACT in IEEE arithmetic (NaN and inf
    21	; included), so neither needs a guard. Without them a gene's `x/1` and
    22	; `-(-1*x)` survive simplification and render as a stray `1.0*x` — the visible
    23	; gap between smallest_form and sympy on real power-plant genes. The protected
    24	; divide qualifies too: protected_div_zero(x, b) is x/b whenever |b| >= 1e-6,
    25	; and |1| is.
    26	(rewrite (Div x (Num 1.0)) x :ruleset algebra)
    27	(rewrite (ProtectedDiv x (Num 1.0)) x :ruleset algebra)
    28	(rewrite (Mul (Num -1.0) x) (Neg x) :ruleset algebra)
    29	(rewrite (Mul x (Num -1.0)) (Neg x) :ruleset algebra)
    30	(rewrite (Div x (Num -1.0)) (Neg x) :ruleset algebra)
    31	(rewrite (ProtectedDiv x (Num -1.0)) (Neg x) :ruleset algebra)
    32	
    33	; ---- Rule 3: additive identity  (x + 0) = x , (0 + x) = x ----
    34	(rewrite (Add x (Num 0.0)) x :ruleset algebra)
    35	(rewrite (Add (Num 0.0) x) x :ruleset algebra)
    36	; and subtractive identity  (x - 0) = x
    37	(rewrite (Sub x (Num 0.0)) x :ruleset algebra)
    38	
    39	; ---- Rule 4: multiplicative zero  (x * 0) = 0 , (0 * x) = 0 ----
    40	(rewrite (Mul x (Num 0.0)) (Num 0.0) :ruleset algebra)
    41	(rewrite (Mul (Num 0.0) x) (Num 0.0) :ruleset algebra)
    42	
    43	; ---- Rule 5: same-op nest collapse ----
    44	; double negation  -(-x) = x
    45	(rewrite (Neg (Neg x)) x :ruleset algebra)
    46	; idempotent abs  |(|x|)| = |x|
    47	(rewrite (Abs (Abs x)) (Abs x) :ruleset algebra)
    48	; sqrt of square  sqrt(x^2) = |x|   (real domain)
    49	(rewrite (Sqrt (Pow2 x)) (Abs x) :ruleset algebra)
    50	
    51	; ---- Additive / subtractive cancellation (Category 1, sound, no guard) ----
    52	; x - x = 0
    53	(rewrite (Sub x x) (Num 0.0) :ruleset algebra)
    54	; (a + b) - b = a ; (b + a) - b = a
    55	(rewrite (Sub (Add a b) b) a :ruleset algebra)
    56	(rewrite (Sub (Add b a) b) a :ruleset algebra)
    57	; (a - b) + b = a ; b + (a - b) = a
    58	(rewrite (Add (Sub a b) b) a :ruleset algebra)
    59	(rewrite (Add b (Sub a b)) a :ruleset algebra)
    60	
    61	; ---- Argument-at-zero / unity folds (Category 1, sound) ----
    62	(rewrite (Sin (Num 0.0)) (Num 0.0) :ruleset algebra)
    63	(rewrite (Cos (Num 0.0)) (Num 1.0) :ruleset algebra)
    64	(rewrite (Tan (Num 0.0)) (Num 0.0) :ruleset algebra)
    65	(rewrite (Tanh (Num 0.0)) (Num 0.0) :ruleset algebra)
    66	(rewrite (Exp (Num 0.0)) (Num 1.0) :ruleset algebra)
    67	(rewrite (Log (Num 1.0)) (Num 0.0) :ruleset algebra)
    68	
    69	; ---- Abs under a proven-positive argument (Category 2, guarded) ----
    70	; |x| = x for x > 0. The guard is caller-supplied domain knowledge (e.g. the
    71	; SR engine's var_ranges) or derived (Exp positivity, positive^p, ...). This
    72	; is the rule that turns Abs(a^(3/2)) into a^(3/2) once `a` is known positive
    73	; — Abs wrappers from protected-sqrt chains are the most common reason an
    74	; R^2=1.0 discovery fails SRBench's exact symbolic-solution check.
    75	(rewrite (Abs x) x :when ((is-positive x)) :ruleset algebra)
    76	; |x| = x for x >= 0 (or NaN). Bit-exact; see `is-nonneg` in GUARD_RELATIONS.
    77	(rewrite (Abs x) x :when ((is-nonneg x)) :ruleset algebra)
    78	
    79	; x * x = x^2 — the evaluator computes Pow2 as a*a, so this is the same
    80	; arithmetic with one node fewer.
    81	(rewrite (Mul x x) (Pow2 x) :ruleset algebra)
    82	
    83	; protected_div_zero(a, b) = 0 whenever |b| < 1e-6, whatever a is. A literal
    84	; divisor that small makes the whole quotient the constant 0.
    85	(rule ((= e (ProtectedDiv x (Num k))) (< k 0.000001) (> k -0.000001))
    86	      ((union e (Num 0.0))) :ruleset algebra)
    87	
    88	; ---- Cancellation on RAW div only (Category 2, guarded; NEVER protected) ----
    89	; x / x = 1  (raw Div, x != 0). protected_div(x,x) is 0 at x=0 -> excluded.
    90	(rewrite (Div x x) (Num 1.0) :when ((is-nonzero x)) :ruleset algebra)
    91	; (a * b) / b = a  (raw Div, b != 0). Both operand orders of the product.
    92	(rewrite (Div (Mul a b) b) a :when ((is-nonzero b)) :ruleset algebra)
    93	(rewrite (Div (Mul b a) b) a :when ((is-nonzero b)) :ruleset algebra)
    94	
    95	; ---- Protected-op rules (the protected variants are otherwise INERT) ----
    96	; protected_sqrt(x^2) = sqrt(|x^2|) = |x|  — sound: |x^2| = x^2, sqrt(x^2)=|x|.
    97	(rewrite (ProtectedSqrt (Pow2 x)) (Abs x) :ruleset algebra)
    98	; NOTE: no other protected rule fires. In particular NONE of the div/inv
    99	; cancellation rules lift onto ProtectedDiv/ProtectedInv — e.g.
   100	; protected_div(x,x) is 0 at x=0 (not 1), and protected_inv(0)=1 (not undefined),
   101	; so the raw guarded rules would be unsound on the protected forms.
   102	"#;
   103	
   104	// Note: Rule 1 (constant folding, e.g. cos(0) -> 1) is data/value driven and
   105	// lands with the evaluator in Phase 1.3-1.4, not as a structural rewrite here.
   106	
