   114	    /// Load Math + guards + algebra, insert `input`, saturate, extract the
   115	    /// lowest-cost form as a string.
   116	    fn simplify(input: &str) -> Result<String, String> {
   117	        let mut egraph = EGraph::default();
   118	        egraph
   119	            .parse_and_run_program(None, MATH_DATATYPE)
   120	            .map_err(|e| format!("datatype: {e}"))?;
   121	        egraph
   122	            .parse_and_run_program(None, GUARD_RELATIONS)
   123	            .map_err(|e| format!("guards: {e}"))?;
   124	        egraph
   125	            .parse_and_run_program(None, ALGEBRA_RULESET)
   126	            .map_err(|e| format!("ruleset: {e}"))?;
   127	        egraph
   128	            .parse_and_run_program(
   129	                None,
   130	                &format!("(let __r {input})\n(run-schedule (saturate (run guards) (run algebra)))"),
   131	            )
   132	            .map_err(|e| format!("insert/saturate {input:?}: {e}"))?;
   133	        let (sort, value) = egraph
   134	            .eval_expr(&exprs::var("__r"))
   135	            .map_err(|e| format!("eval: {e}"))?;
   136	        let (best, _cost) = egraph
   137	            .extract_value_to_string(&sort, value)
   138	            .map_err(|e| format!("extract: {e}"))?;
   139	        Ok(best)
   140	    }
   141	
   142	    /// Like `simplify` but asserts extra guard facts (e.g. `(is-nonzero ...)`)
   143	    /// before saturating — used to test that guarded rules fire when their
   144	    /// precondition is known.
   145	    fn simplify_with_facts(input: &str, facts: &str) -> Result<String, String> {
   146	        let mut egraph = EGraph::default();
   147	        egraph.parse_and_run_program(None, MATH_DATATYPE).map_err(|e| format!("datatype: {e}"))?;
   148	        egraph.parse_and_run_program(None, GUARD_RELATIONS).map_err(|e| format!("guards: {e}"))?;
   149	        egraph.parse_and_run_program(None, ALGEBRA_RULESET).map_err(|e| format!("ruleset: {e}"))?;
   150	        egraph
   151	            .parse_and_run_program(
   152	                None,
   153	                &format!(
   154	                    "(let __r {input})\n{facts}\n(run-schedule (saturate (run guards) (run algebra)))"
   155	                ),
   156	            )
   157	            .map_err(|e| format!("insert/saturate {input:?}: {e}"))?;
   158	        let (sort, value) = egraph.eval_expr(&exprs::var("__r")).map_err(|e| format!("eval: {e}"))?;
   159	        let (best, _cost) = egraph.extract_value_to_string(&sort, value).map_err(|e| format!("extract: {e}"))?;
   160	        Ok(best)
   161	    }
