   471	
   472	    // BFS the tree; emit a Token per node in level order. Functions become
   473	    // Func tokens (by semantic id -> pset name); leaves become Var/Num tokens.
   474	    let mut head: Vec<Token> = Vec::new();
   475	    let mut queue: std::collections::VecDeque<&MathNode> = std::collections::VecDeque::new();
   476	    queue.push_back(&root);
   477	    while let Some(node) = queue.pop_front() {
