   473	fn parse(toks: &[String], pos: &mut usize) -> Result<Tree, String> {
   474	    let t = toks.get(*pos).ok_or("unexpected end of input")?;
   475	    if t != "(" {
   476	        return Err(format!("expected '(' at {pos}, found {t:?}"));
   477	    }
   478	    *pos += 1;
   479	    let head = toks.get(*pos).ok_or("missing constructor")?.clone();
   480	    *pos += 1;
   481	
   482	    let node = match head.as_str() {
   483	        "Num" => {
   484	            let v = toks.get(*pos).ok_or("Num missing value")?;
   485	            *pos += 1;
   486	            Tree::Num(v.parse::<f64>().map_err(|e| format!("bad Num {v:?}: {e}"))?)
   487	        }
   488	        "Var" => {
   489	            let v = toks.get(*pos).ok_or("Var missing name")?;
   490	            *pos += 1;
   491	            Tree::Var(v.trim_matches('"').to_string())
   492	        }
   493	        _ => {
   494	            let op = Op::from_math(&head)
   495	                .ok_or_else(|| format!("unknown Math constructor {head:?}"))?;
   496	            let mut kids = Vec::new();
   497	            for _ in 0..op.arity() {
   498	                kids.push(parse(toks, pos)?);
   499	            }
   500	            Tree::App(head.clone(), kids)
   501	        }
   502	    };
   503	
   504	    match toks.get(*pos) {
   505	        Some(t) if t == ")" => {
   506	            *pos += 1;
   507	            Ok(node)
   508	        }
   509	        other => Err(format!("expected ')' closing {head}, found {other:?}")),
   510	    }
   511	}
