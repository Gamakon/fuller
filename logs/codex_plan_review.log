   163	    /// Each rule fires on its target pattern.
   164	    #[test]
   165	    fn each_rule_fires() {
   166	        let cases: &[(&str, &str)] = &[
   167	            // mul identity, both orders
   168	            (r#"(Mul (Var "x") (Num 1.0))"#, r#"(Var "x")"#),
   169	            (r#"(Mul (Num 1.0) (Var "x"))"#, r#"(Var "x")"#),
   170	            (r#"(Div (Var "x") (Num 1.0))"#, r#"(Var "x")"#),
   171	            (r#"(ProtectedDiv (Var "x") (Num 1.0))"#, r#"(Var "x")"#),
   172	            (r#"(Neg (Mul (Num -1.0) (Var "x")))"#, r#"(Var "x")"#),
   173	            (r#"(Mul (Num -1.0) (Mul (Num -1.0) (Var "x")))"#, r#"(Var "x")"#),
   174	            (r#"(Div (Var "x") (Num -1.0))"#, r#"(Neg (Var "x"))"#),
   175	            // add / sub identity
   176	            (r#"(Add (Var "x") (Num 0.0))"#, r#"(Var "x")"#),
   177	            (r#"(Add (Num 0.0) (Var "x"))"#, r#"(Var "x")"#),
   178	            (r#"(Sub (Var "x") (Num 0.0))"#, r#"(Var "x")"#),
   179	            // mul zero, both orders
   180	            (r#"(Mul (Var "x") (Num 0.0))"#, "(Num 0.0)"),
   181	            (r#"(Mul (Num 0.0) (Var "x"))"#, "(Num 0.0)"),
   182	            // same-op collapse
   183	            (r#"(Neg (Neg (Var "x")))"#, r#"(Var "x")"#),
   184	            (r#"(Abs (Abs (Var "x")))"#, r#"(Abs (Var "x"))"#),
   185	            (r#"(Sqrt (Pow2 (Var "x")))"#, r#"(Abs (Var "x"))"#),
   186	        ];
   187	        let mut failures = Vec::new();
   188	        for (input, expected) in cases {
   189	            match simplify(input) {
   190	                Ok(got) if got == *expected => {}
   191	                Ok(got) => failures.push(format!("{input}\n  got:      {got}\n  expected: {expected}")),
   192	                Err(e) => failures.push(format!("{input}\n  error: {e}")),
   193	            }
   194	        }
   195	        assert!(failures.is_empty(), "{} failed:\n{}", failures.len(), failures.join("\n"));
   196	    }
