   439	fn tokenize(s: &str) -> Vec<String> {
   440	    let mut out = Vec::new();
   441	    let mut cur = String::new();
   442	    let mut in_str = false;
   443	    for c in s.chars() {
   444	        match c {
   445	            '"' => {
   446	                in_str = !in_str;
   447	                cur.push(c);
   448	                if !in_str {
   449	                    out.push(std::mem::take(&mut cur));
   450	                }
   451	            }
   452	            _ if in_str => cur.push(c),
   453	            '(' | ')' => {
   454	                if !cur.is_empty() {
   455	                    out.push(std::mem::take(&mut cur));
   456	                }
   457	                out.push(c.to_string());
   458	            }
   459	            c if c.is_whitespace() => {
   460	                if !cur.is_empty() {
   461	                    out.push(std::mem::take(&mut cur));
   462	                }
   463	            }
   464	            _ => cur.push(c),
   465	        }
   466	    }
   467	    if !cur.is_empty() {
   468	        out.push(cur);
   469	    }
   470	    out
   471	}
