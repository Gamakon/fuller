    46	/// The `rational` ruleset.
    47	pub const RATIONAL_RULESET: &str = r#"
    48	(ruleset rational)
    49	
    50	; ---- numeric folds for the square/cube/inv constructors ----
    51	; egglog only has primitive + - * neg on f64; distribute folds those. The
    52	; square-expansion rules below produce (Pow2 (Num c)) / (Pow3 (Num c)) terms,
    53	; so fold them to literals here (strictly reduces Num-node count).
    54	(rewrite (Pow2 (Num a)) (Num (* a a)) :ruleset rational)
    55	(rewrite (Pow3 (Num a)) (Num (* a (* a a))) :ruleset rational)
    56	
    57	; ---- binomial square expansion (sound for all reals), ATOM-GATED ----
    58	; (a + b)^2 = a^2 + 2ab + b^2 — but ONLY when BOTH operands are "square-safe":
    59	; a leaf-ish term that is NOT itself a sum or a square. Expanding a square
    60	; whose operand is another (Add ..) / (Pow2 ..) lets the e-graph re-square the
    61	; result over and over (degree-2 -> 4 -> 8 ...) and diverges in combination
    62	; with `distribute` (measured: it pegs the CPU on nested-square radsimp pairs).
    63	; The gate keeps a well-founded measure: each expansion strictly removes one
    64	; `Pow2 (Add ..)` over square-safe leaves and never re-introduces one.
    65	;
    66	; `sq-safe` is seeded on the non-compound operand shapes that actually occur as
    67	; binomial terms in the corpus. A bare (Add ..) / (Sub ..) / (Pow2 ..) operand
    68	; is deliberately NOT square-safe, which is what blocks the cascade.
    69	; `leaf` = a term that does NOT itself rewrite into a sum and is not a square:
    70	; Num / Var / Inv / Sqrt / Abs / Pow. (Crucially NOT Add / Sub / Pow2 / Pow3.)
    71	(relation leaf (Math))
    72	(rule ((= m (Num a)))   ((leaf m)) :ruleset rational)
    73	(rule ((= m (Var s)))   ((leaf m)) :ruleset rational)
    74	(rule ((= m (Inv x)))   ((leaf m)) :ruleset rational)
    75	(rule ((= m (Sqrt x)))  ((leaf m)) :ruleset rational)
    76	(rule ((= m (Abs x)))   ((leaf m)) :ruleset rational)
    77	(rule ((= m (Pow x y))) ((leaf m)) :ruleset rational)
    78	
    79	; `sq-safe` = an operand we may expand a square over without cascading: every
    80	; leaf is sq-safe, and a PRODUCT of two leaves is sq-safe. A product whose
    81	; factor is itself a square (e.g. `2 * (a+b)^2`) is NOT sq-safe — expanding the
    82	; enclosing square re-squares that nested square and diverges degree 2->4->8
    83	; with `distribute` (measured on nested-square radsimp pairs). Likewise a bare
    84	; sum / square operand is not sq-safe.
    85	(relation sq-safe (Math))
    86	(rule ((leaf m))                          ((sq-safe m)) :ruleset rational)
    87	(rule ((= m (Mul a b)) (leaf a) (leaf b)) ((sq-safe m)) :ruleset rational)
    88	
    89	; (a + b)^2 = a^2 + 2ab + b^2
    90	(rewrite (Pow2 (Add a b))
    91	    (Add (Add (Pow2 a) (Pow2 b)) (Mul (Num 2.0) (Mul a b)))
    92	    :when ((sq-safe a) (sq-safe b)) :ruleset rational)
    93	; (a - b)^2 = a^2 - 2ab + b^2
    94	(rewrite (Pow2 (Sub a b))
    95	    (Add (Add (Pow2 a) (Pow2 b)) (Mul (Num -2.0) (Mul a b)))
    96	    :when ((sq-safe a) (sq-safe b)) :ruleset rational)
    97	
    98	; ---- Pow integer-exponent normalisation onto Pow2/Pow3/Inv ----
    99	; x^-1 = 1/x
   100	(rewrite (Pow x (Num -1.0)) (Inv x) :ruleset rational)
   101	; x^-2 = 1/x^2
   102	(rewrite (Pow x (Num -2.0)) (Inv (Pow2 x)) :ruleset rational)
   103	; x^-3 = 1/x^3
   104	(rewrite (Pow x (Num -3.0)) (Inv (Pow3 x)) :ruleset rational)
   105	; x^4 = (x^2)^2
   106	(rewrite (Pow x (Num 4.0)) (Pow2 (Pow2 x)) :ruleset rational)
   107	; x^-4 = 1/(x^2)^2
   108	(rewrite (Pow x (Num -4.0)) (Inv (Pow2 (Pow2 x))) :ruleset rational)
   109	; x^6 = (x^3)^2
   110	(rewrite (Pow x (Num 6.0)) (Pow2 (Pow3 x)) :ruleset rational)
   111	; x^8 = ((x^2)^2)^2
   112	(rewrite (Pow x (Num 8.0)) (Pow2 (Pow2 (Pow2 x))) :ruleset rational)
   113	
   114	; ---- Inv canonicalisation ----
   115	; 1/(1/x) = x   (guarded: x != 0, so that 1/x is itself defined)
   116	(rewrite (Inv (Inv x)) x :when ((is-nonzero x)) :ruleset rational)
   117	; x * (1/x) = 1 for x != 0, either way round. `(Div x x) -> 1` was already
   118	; here; the Inv spelling of the same fact was not, and a GEP gene reaches it
   119	; as readily (mul(x, inv(x)) is two tokens).
   120	(rewrite (Mul x (Inv x)) (Num 1.0) :when ((is-nonzero x)) :ruleset rational)
   121	(rewrite (Mul (Inv x) x) (Num 1.0) :when ((is-nonzero x)) :ruleset rational)
   122	; (1/a)*(1/b) = 1/(a*b)  — sound for all reals (both sides NaN where undefined)
   123	(rewrite (Mul (Inv a) (Inv b)) (Inv (Mul a b)) :ruleset rational)
   124	
   125	; ---- Mined from the hall of fame (docs/rule_proposals/rational.md) ----
   126	; 1/x = Inv x. RAW Div only: both are NaN at x = 0. NOT ProtectedDiv:
   127	; protected_div(1, x) is 0 for |x| < 1e-6 while ProtectedInv(0) is 1.
   128	(rewrite (Div (Num 1.0) x) (Inv x) :ruleset rational)
   129	(rewrite (Div (Num -1.0) x) (Neg (Inv x)) :ruleset rational)
   130	; a * (1/b) = a/b, the rule this module's doc promised. RAW Inv only:
   131	; a * ProtectedInv(0) is a, ProtectedDiv(a, 0) is 0.
   132	(rewrite (Mul a (Inv b)) (Div a b) :ruleset rational)
   133	(rewrite (Mul (Inv b) a) (Div a b) :ruleset rational)
   134	; (1/a)/b = 1/(a*b): a = 0 or b = 0 is NaN on both sides. Raw only.
   135	(rewrite (Div (Inv a) b) (Inv (Mul a b)) :ruleset rational)
   136	; Two literals separated by a non-constant. fold_constant_subtrees only sees
   137	; CLOSED subtrees, and distribute (which has one of these) is not loaded by
   138	; smallest_form.
   139	(rewrite (Mul (Mul p (Num a)) (Num b)) (Mul p (Num (* a b))) :ruleset rational)
   140	(rewrite (Mul (Num a) (Mul (Num b) p)) (Mul (Num (* a b)) p) :ruleset rational)
   141	(rewrite (Add (Num a) (Add (Num b) q)) (Add (Num (+ a b)) q) :ruleset rational)
   142	(rewrite (Add (Add q (Num a)) (Num b)) (Add q (Num (+ a b))) :ruleset rational)
   143	; ProtectedInv x IS 1/x whenever x != 0. Same size; it lets every raw Inv rule
   144	; reach the protected spelling. Unguarded it is wrong at exactly x = 0 (1 vs NaN).
   145	(rewrite (ProtectedInv x) (Inv x) :when ((is-nonzero x)) :ruleset rational)
   146	"#;
