   513	/// Breadth-first flatten with child indices resolved.
   514	fn flatten(root: &Tree, vars: &[String]) -> Result<Vec<GpuNode>, String> {
   515	    let mut out: Vec<GpuNode> = Vec::new();
   516	    // (tree, index of the slot already reserved in `out`)
   517	    let mut queue: std::collections::VecDeque<(&Tree, usize)> =
   518	        std::collections::VecDeque::new();
   519	
   520	    out.push(GpuNode { op: 0, arg0: 0, arg1: 0, konst: 0.0 });
   521	    queue.push_back((root, 0));
   522	
   523	    while let Some((tree, slot)) = queue.pop_front() {
   524	        match tree {
   525	            Tree::Num(v) => {
   526	                out[slot] = GpuNode {
   527	                    op: Op::Num as u32,
   528	                    arg0: 0,
   529	                    arg1: 0,
   530	                    konst: *v as f32,
   531	                };
   532	            }
   533	            Tree::Var(name) => {
   534	                let col = vars
   535	                    .iter()
   536	                    .position(|v| v == name)
   537	                    .ok_or_else(|| format!("variable {name:?} not in {vars:?}"))?;
   538	                out[slot] = GpuNode {
   539	                    op: Op::Var as u32,
   540	                    arg0: col as u32,
   541	                    arg1: 0,
   542	                    konst: 0.0,
   543	                };
   544	            }
   545	            Tree::App(head, kids) => {
   546	                let op = Op::from_math(head)
   547	                    .ok_or_else(|| format!("unknown constructor {head:?}"))?;
   548	                // Reserve the children's slots now so their indices are known.
   549	                let first = out.len();
   550	                for _ in kids {
   551	                    out.push(GpuNode { op: 0, arg0: 0, arg1: 0, konst: 0.0 });
   552	                }
   553	                out[slot] = GpuNode {
   554	                    op: op as u32,
   555	                    arg0: first as u32,
   556	                    arg1: if kids.len() > 1 { first as u32 + 1 } else { 0 },
   557	                    konst: 0.0,
   558	                };
   559	                for (i, k) in kids.iter().enumerate() {
   560	                    queue.push_back((k, first + i));
   561	                }
   562	            }
   563	        }
   564	        if out.len() > MAX_NODES {
   565	            return Err(format!("expression exceeds MAX_NODES ({MAX_NODES})"));
   566	        }
   567	    }
