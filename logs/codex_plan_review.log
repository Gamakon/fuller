   391	/// Parse a `Math` s-expression into level-order [`GpuNode`]s.
   392	///
   393	/// This is the piece that makes the kernel usable: without it the evaluator
   394	/// can only be driven by hand-built node arrays, which tests nothing about
   395	/// real chromosomes.
   396	///
   397	/// Emits BREADTH-FIRST, because the kernel's backward scan relies on every
   398	/// child sitting at a higher index than its parent. A depth-first emit would
   399	/// break that invariant and silently compute nonsense.
   400	///
   401	/// `vars` maps a variable name to its column in the resident data buffer. A
   402	/// name not in `vars` is an error rather than a default, because silently
   403	/// reading column 0 would produce a plausible wrong answer.
   404	pub fn math_to_nodes(expr: &str, vars: &[String]) -> Result<Vec<GpuNode>, String> {
   405	    let toks = tokenize(expr);
   406	    let mut pos = 0usize;
   407	    let tree = parse(&toks, &mut pos)?;
   408	    if pos != toks.len() {
   409	        return Err(format!("trailing tokens at {pos} in {expr:?}"));
   410	    }
   411	    flatten(&tree, vars)
   412	}
