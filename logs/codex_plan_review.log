   158	/// Convert a karva (head, tail) chromosome to a `Math` s-expression string.
   159	///
   160	/// Decodes the live expression by the GEP level-order rule and renders it.
   161	/// Neutral-region tokens (beyond the live expression) are ignored, exactly as
   162	/// they would be when the chromosome is evaluated.
   163	pub fn karva_to_terms(head: &[Token], tail: &[Token], pset: &PsetSpec) -> Result<String, String> {
   164	    if head.is_empty() {
   165	        return Err("empty head".to_string());
   166	    }
   167	    // The combined stream the GEP rule walks.
   168	    let stream: Vec<&Token> = head.iter().chain(tail.iter()).collect();
   169	
   170	    // Determine each function token's arity, walking the head and consuming
   171	    // child slots level-order. `child_slots[i]` = the stream indices of node
   172	    // i's children.
   173	    let mut children_of: Vec<Vec<usize>> = vec![Vec::new(); stream.len()];
   174	    let mut next_slot = 1usize;
   175	    for (i, tok) in head.iter().enumerate() {
   176	        // A token at or beyond `next_slot` was never assigned as any live
   177	        // node's child: it sits in the neutral (dead) region, which the GEP
   178	        // decode rule ignores. Since `next_slot` only grows from live function
   179	        // tokens, everything from here on is dead — stop, and never validate
   180	        // or consume slots for dead tokens (an unmapped token in the neutral
   181	        // region must not fail an otherwise valid chromosome).
   182	        if i > 0 && i >= next_slot {
   183	            break;
   184	        }
   185	        if let Token::Func(name) = tok {
   186	            let spec = pset
   187	                .functions
   188	                .get(name)
   189	                .ok_or_else(|| format!("function token {name:?} not in pset"))?;
   190	            for _ in 0..spec.arity {
   191	                if next_slot >= stream.len() {
   192	                    return Err(format!(
   193	                        "ran out of tokens decoding {name:?}: GEP tail too short"
   194	                    ));
   195	                }
   196	                children_of[i].push(next_slot);
   197	                next_slot += 1;
   198	            }
   199	        }
   200	    }
   201	
   202	    // Recursively render from the root (stream index 0). Depth-capped: a
   203	    // deeper-than-sane gene must surface as an Err, not a stack overflow.
   204	    fn render(
   205	        idx: usize,
   206	        stream: &[&Token],
   207	        children_of: &[Vec<usize>],
   208	        pset: &PsetSpec,
   209	        depth: usize,
   210	    ) -> Result<String, String> {
   211	        if depth > crate::MAX_EXPR_DEPTH {
   212	            return Err(format!(
   213	                "expression deeper than MAX_EXPR_DEPTH ({})",
   214	                crate::MAX_EXPR_DEPTH
   215	            ));
   216	        }
   217	        match stream[idx] {
   218	            Token::Func(name) => {
   219	                let spec = pset
   220	                    .functions
   221	                    .get(name)
   222	                    .ok_or_else(|| format!("function token {name:?} not in pset"))?;
   223	                let kids: Result<Vec<String>, String> = children_of[idx]
   224	                    .iter()
   225	                    .map(|&c| render(c, stream, children_of, pset, depth + 1))
   226	                    .collect();
   227	                semantic_to_math(&spec.semantic_id, &kids?)
   228	            }
   229	            leaf => leaf_to_math(leaf, pset),
   230	        }
   430	}
