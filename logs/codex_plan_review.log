   489	                // Validate on encode, symmetrically with `leaf_to_math` on the
   490	                // decode side: emitting a Var outside the pset would produce a
   491	                // chromosome the engine can never decode again.
   492	                if !pset.variables.iter().any(|v| v == name) {
