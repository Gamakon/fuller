     1	//! GPU batch evaluator: many expressions, one dispatch, data resident.
     2	//!
     3	//! # Why this shape
     4	//!
     5	//! An e-graph saturation turns one gene into a whole equivalence class, and a
     6	//! population turns that into a lot of expressions:
     7	//!
     8	//! ```text
     9	//! 100 individuals x 3 genes x ~20 e-class variants x 3 wrappers = ~18,000
    10	//! ```
    11	//!
    12	//! Every one of those is the same interpreter over a different token array,
    13	//! evaluated against the same rows. No communication between them. That is the
    14	//! shape a GPU is for.
    15	//!
    16	//! The dataset is uploaded ONCE and stays resident: subsequent generations
    17	//! write only a token buffer (a few hundred KB) and dispatch. What comes back
    18	//! is a reduction — per-expression error terms — not predictions, so the return
    19	//! trip is ~6 floats per expression rather than rows x expressions.
    20	//!
    21	//! # Why an interpreter, not generated shaders
    22	//!
    23	//! Compiling WGSL per chromosome costs milliseconds; evaluating 800 rows costs
    24	//! microseconds. So there is ONE kernel, compiled once, and the population
    25	//! arrives as data. Karva is already a flat, arity-bounded linearisation, so a
    26	//! gene is a token array and needs no parsing.
    27	//!
    28	//! # Why the control flow does not diverge
    29	//!
    30	//! Karva is level-order, so a node's children sit at positions determined by
    31	//! the arities before it — computable from the TOKENS ALONE, independent of the
    32	//! data. Child offsets are resolved once on the host into an index table, and
    33	//! the kernel then walks the array in reverse: every node's children are at
    34	//! higher indices, so one backward linear scan yields the root. Threads in a
    35	//! warp run the same op sequence over different rows, which is the property
    36	//! that makes this worth doing at all.
    37	//!
    38	//! # Measured sizes (why a fixed scratch works)
    39	//!
    40	//! Real k-expressions are short — median 1-2 tokens, p90 6-7, max 34 across
    41	//! head=16 and head=48 populations — because decoding stops as soon as arity is
    42	//! satisfied. So [`MAX_NODES`] scratch floats per thread fits in registers and
    43	//! occupancy is not the constraint I expected it to be.
    44	//!
    45	//! # Precision
    46	//!
    47	//! f32 on device. That is fine for ranking and search, and NOT fine for an
    48	//! exact-recovery gate: a recovered Lorentz form passed at 1.6e-13 relative
    49	//! error, which f32 cannot represent. Use this to shortlist, then re-score
    50	//! finalists on the CPU f64 evaluator in [`crate::eval`], which stays the
    51	//! correctness reference.
    52	
    53	/// Longest k-expression this evaluator handles. Measured p90 is 6-7 and the
    54	/// observed max is 34; 64 leaves headroom while keeping per-thread scratch at
    55	/// 64 floats. Longer expressions fall back to the CPU evaluator rather than
    56	/// being silently truncated.
    57	pub const MAX_NODES: usize = 64;
    58	
    59	/// wgpu's per-dimension workgroup cap (`max_compute_workgroups_per_dimension`).
    60	pub const MAX_GROUPS_PER_DIM: u32 = 65535;
    61	
    62	/// Opcodes. These MUST match `crate::eval` semantics exactly — in particular
    63	/// the `Protected*` variants, which are not "raw op plus a guard" but distinct
    64	/// functions with the engine's own behaviour on negatives, zero and overflow.
    65	/// A divergence here silently breaks fuller's soundness claims, so the parity
    66	/// test against the CPU evaluator is the gate on this whole module.
    67	#[repr(u32)]
    68	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    69	pub enum Op {
    70	    /// Leaf: read variable `arg0` from the resident data buffer.
    71	    Var = 0,
    72	    /// Leaf: literal, value carried in the token's `konst` field.
    73	    Num = 1,
    74	    Add = 2,
    75	    Sub = 3,
    76	    Mul = 4,
    77	    Div = 5,
    78	    Neg = 6,
    79	    Abs = 7,
    80	    Sqrt = 8,
    81	    Log = 9,
    82	    Exp = 10,
    83	    Sin = 11,
    84	    Cos = 12,
    85	    Tan = 13,
    86	    Tanh = 14,
    87	    Pow = 15,
    88	    Pow2 = 16,
    89	    Pow3 = 17,
    90	    Inv = 18,
    91	    ProtectedDiv = 19,
    92	    ProtectedSqrt = 20,
    93	    ProtectedLog = 21,
    94	    ProtectedExp = 22,
    95	    ProtectedInv = 23,
    96	}
    97	
    98	impl Op {
    99	    /// Map a `Math` constructor name to an opcode.
   100	    pub fn from_math(name: &str) -> Option<Op> {
   101	        Some(match name {
   102	            "Var" => Op::Var,
   103	            "Num" => Op::Num,
   104	            "Add" => Op::Add,
   105	            "Sub" => Op::Sub,
   106	            "Mul" => Op::Mul,
   107	            "Div" => Op::Div,
   108	            "Neg" => Op::Neg,
   109	            "Abs" => Op::Abs,
   110	            "Sqrt" => Op::Sqrt,
   111	            "Log" => Op::Log,
   112	            "Exp" => Op::Exp,
   113	            "Sin" => Op::Sin,
   114	            "Cos" => Op::Cos,
   115	            "Tan" => Op::Tan,
   116	            "Tanh" => Op::Tanh,
   117	            "Pow" => Op::Pow,
   118	            "Pow2" => Op::Pow2,
   119	            "Pow3" => Op::Pow3,
   120	            "Inv" => Op::Inv,
   121	            "ProtectedDiv" => Op::ProtectedDiv,
   122	            "ProtectedSqrt" => Op::ProtectedSqrt,
   123	            "ProtectedLog" => Op::ProtectedLog,
   124	            "ProtectedExp" => Op::ProtectedExp,
   125	            "ProtectedInv" => Op::ProtectedInv,
   126	            _ => return None,
   127	        })
   128	    }
   129	
   130	    pub fn arity(self) -> usize {
   131	        match self {
   132	            Op::Var | Op::Num => 0,
   133	            Op::Neg
   134	            | Op::Abs
   135	            | Op::Sqrt
   136	            | Op::Log
   137	            | Op::Exp
   138	            | Op::Sin
   139	            | Op::Cos
   140	            | Op::Tan
   141	            | Op::Tanh
   142	            | Op::Pow2
   143	            | Op::Pow3
   144	            | Op::Inv
   145	            | Op::ProtectedSqrt
   146	            | Op::ProtectedLog
   147	            | Op::ProtectedExp
   148	            | Op::ProtectedInv => 1,
   149	            _ => 2,
   150	        }
   151	    }
   152	}
   153	
   154	/// One node, as uploaded. 16 bytes, so a 64-node expression is 1 KiB and a
   155	/// 18,000-expression population is ~18 MiB — well inside a 128 MiB Metal
   156	/// binding cap, no banding needed at these sizes.
   157	#[repr(C)]
   158	#[derive(Debug, Clone, Copy)]
   159	pub struct GpuNode {
   160	    /// [`Op`] as u32.
   161	    pub op: u32,
   162	    /// `Var`: column index into the resident data buffer. Otherwise: index of
   163	    /// the first child, resolved on the host.
   164	    pub arg0: u32,
   165	    /// Index of the second child for binary ops; unused otherwise.
   166	    pub arg1: u32,
   167	    /// Literal value for `Num`; unused otherwise.
   168	    pub konst: f32,
   169	}
   170	
   171	/// The WGSL interpreter.
   172	///
   173	/// One thread per `(expression, row)`. Each walks its own node slice backwards,
   174	/// filling a scratch array, and writes the root value. Control flow is uniform
   175	/// across the rows of one expression: the `switch` selects on the opcode, which
   176	/// is a property of the token array, not of the data.
   177	///
   178	/// Protected-op semantics are written out explicitly rather than reusing the
   179	/// raw ops, because they are different functions. `ProtectedExp` is uncapped
   180	/// and returns +inf on overflow, matching the engine.
   181	pub const EVAL_WGSL: &str = r#"
   182	struct Node {
   183	    op: u32,
   184	    arg0: u32,
   185	    arg1: u32,
   186	    konst: f32,
   187	};
   188	
   189	struct Meta {
   190	    n_expr: u32,
   191	    n_rows: u32,
   192	    n_vars: u32,
   193	    // Invocations per dispatch ROW (groups_x * 64). One dimension caps at
   194	    // 65535 workgroups = 4.19M invocations, and the population x e-class
   195	    // cross-product is far past that, so the dispatch is 2-D.
   196	    stride: u32,
   197	};
   198	
   199	@group(0) @binding(0) var<storage, read>       nodes:   array<Node>;
   200	// expr i owns nodes[offsets[i] .. offsets[i] + lengths[i])
   201	@group(0) @binding(1) var<storage, read>       offsets: array<u32>;
   202	@group(0) @binding(2) var<storage, read>       lengths: array<u32>;
   203	// row-major: data[row * n_vars + col]. Uploaded once, never moved.
   204	@group(0) @binding(3) var<storage, read>       data:    array<f32>;
   205	@group(0) @binding(4) var<storage, read_write> out:     array<f32>;
   206	@group(0) @binding(5) var<uniform>             cfg:     Meta;
   207	
   208	const MAX_NODES: u32 = 64u;
   209	fn nan() -> f32 { return bitcast<f32>(0x7fc00000u); }
   210	fn pos_inf() -> f32 { return bitcast<f32>(0x7f800000u); }
   211	// NaN fails every comparison, so this is false for NaN and for +-inf.
   212	fn is_finite(x: f32) -> bool { return abs(x) <= 3.4028235e38; }
   213	fn is_inf(x: f32) -> bool { return abs(x) > 3.4028235e38; }
   214	// f32 cannot carry the PHASE of an angle this large: at 1e7 adjacent floats are
   215	// 1.0 apart, a sixth of a period. Metal's sin/cos are accurate to 1e-8 up to
   216	// 3e6 (measured) and return exactly 0.0 from 1e7 on — a wrong number that
   217	// looks valid. Beyond this the expression is refused, not answered.
   218	const TRIG_MAX_ARG: f32 = 1.0e7;
   219	fn trig_ok(x: f32) -> bool { return abs(x) < TRIG_MAX_ARG; }
   220	
   221	@compute @workgroup_size(64, 1, 1)
   222	fn eval_main(@builtin(global_invocation_id) gid: vec3<u32>) {
   223	    let idx = gid.y * cfg.stride + gid.x;
   224	    let total = cfg.n_expr * cfg.n_rows;
   225	    if (idx >= total) { return; }
   226	
   227	    let expr = idx / cfg.n_rows;
   228	    let row  = idx % cfg.n_rows;
   229	
   230	    let base = offsets[expr];
   231	    let n    = lengths[expr];
   232	    if (n == 0u || n > MAX_NODES) {
   233	        out[idx] = bitcast<f32>(0x7fc00000u);   // NaN: caller falls back to CPU
   234	        return;
   235	    }
   236	
   237	    var scratch: array<f32, 64>;
   238	    // Set when the ENGINE would raise rather than return: Python's math.sin /
   239	    // math.cos raise ValueError on +-inf, and the engine rejects the whole
   240	    // individual. A NaN is not enough to say that — ProtectedSqrt maps
   241	    // non-finite to 0.0 and would swallow it — so it is carried separately.
   242	    var poison: bool = false;
   243	
   244	    // Backward scan. Karva is level-order, so every child index is greater
   245	    // than its parent's — one reverse pass resolves the whole tree with no
   246	    // stack and no recursion.
   247	    var k: u32 = n;
   248	    loop {
   249	        if (k == 0u) { break; }
   250	        k = k - 1u;
   251	        let nd = nodes[base + k];
   252	        var v: f32 = 0.0;
   253	        switch (nd.op) {
   254	            case 0u: { v = data[row * cfg.n_vars + nd.arg0]; }   // Var
   255	            case 1u: { v = nd.konst; }                            // Num
   256	            case 2u: { v = scratch[nd.arg0] + scratch[nd.arg1]; }
   257	            case 3u: { v = scratch[nd.arg0] - scratch[nd.arg1]; }
   258	            case 4u: { v = scratch[nd.arg0] * scratch[nd.arg1]; }
   259	            // Raw ops carry the crate's div0 contract: division by zero is
   260	            // NaN, NOT IEEE infinity. Bare `/` gives inf, which diverges from
   261	            // eval.rs and would put a +inf member and a NaN member in the same
   262	            // e-class (Pow(x,-1) and Inv(x) are equivalent under the rules).
   263	            case 5u: {                                             // Div
   264	                let d = scratch[nd.arg1];
   265	                if (d == 0.0) { v = nan(); } else { v = scratch[nd.arg0] / d; }
   266	            }
   267	            case 6u: { v = -scratch[nd.arg0]; }
   268	            case 7u: { v = abs(scratch[nd.arg0]); }
   269	            case 8u: {                                             // Sqrt
   270	                let a = scratch[nd.arg0];
   271	                if (a < 0.0) { v = nan(); } else { v = sqrt(a); }
   272	            }
   273	            case 9u: {                                             // Log
   274	                let a = scratch[nd.arg0];
   275	                if (a <= 0.0) { v = nan(); } else { v = log(a); }
   276	            }
   277	            case 10u: { v = exp(scratch[nd.arg0]); }
   278	            // WGSL leaves trig of a non-finite input UNDEFINED, and Metal
   279	            // returns a finite number for cos(inf): an individual the engine
   280	            // rejects was being scored. Non-finite in -> NaN out, and +-inf
     1	//! Phase 1.1: karva (GEP K-expression) <-> `Math` term converter.
     2	//!
     3	//! This is the boundary the SR engine crosses: it speaks karva chromosomes
     4	//! (flat head+tail token lists), fuller speaks `Math` s-expressions. The
     5	//! converter is keyed on `semantic_id` (what an operator *computes*), never a
     6	//! pset-specific geppy name — the consumer maps its names to semantic ids when
     7	//! it builds the `PsetSpec`. Ported (clean, no geppy/sympy) from the GEP decode
     8	//! rule in hff `_gene_decompose.py` / `_sympy_to_karva.py`.
     9	//!
    10	//! GEP decode rule: walk the head left-to-right; each function token consumes
    11	//! `arity` children from the next available slots in the head+tail stream
    12	//! (level-order / BFS). Tail tokens are terminals only.
    13	
    14	use std::collections::HashMap;
    15	
    16	/// One operator in the pset, described by what it *computes*.
    17	#[derive(Debug, Clone)]
    18	pub struct FunctionSpec {
    19	    /// Semantic id: one of the `Math` ops, lowercase
    20	    /// (add sub mul div neg sin cos log exp sqrt abs tanh pow2 pow3 inv).
    21	    pub semantic_id: String,
    22	    /// Arity (1 or 2 for the current Math set).
    23	    pub arity: usize,
    24	}
    25	
    26	/// Pure-data description of the pset (no geppy dependency).
    27	#[derive(Debug, Clone)]
    28	pub struct PsetSpec {
    29	    /// Variable names, e.g. ["x0", "x1"].
    30	    pub variables: Vec<String>,
    31	    /// Functions, keyed for lookup by the token strings the engine emits.
    32	    /// The map is `token_name -> FunctionSpec`.
    33	    pub functions: HashMap<String, FunctionSpec>,
    34	    /// Numeric RNC constants addressable by index.
    35	    pub rnc_values: Vec<f64>,
    36	}
    37	
    38	/// A karva token: either a function name, a variable name, or a numeric
    39	/// constant. The engine's flat head/tail lists are `Vec<Token>`.
    40	#[derive(Debug, Clone, PartialEq)]
    41	pub enum Token {
    42	    /// A function token — looked up in `PsetSpec::functions`.
    43	    Func(String),
    44	    /// A variable token — must be in `PsetSpec::variables`.
    45	    Var(String),
    46	    /// A numeric literal.
    47	    Num(f64),
    48	}
    49	
    50	/// The MASTER semantic-id set: every `(semantic_id, arity)` any rewrite or
    51	/// physics-prior rule can emit. The SR engine seeds its pset with one token per
    52	/// entry up front; then `terms_to_karva` can always name any candidate, so no
    53	/// generated chromosome is ever dropped as inexpressible.
    54	///
    55	/// This is the single source of truth, kept in lockstep with `semantic_to_math`
    56	/// (a test asserts every entry round-trips through it). `diff_sq` is omitted
    57	/// deliberately — it lowers to `pow2`+`sub`, which are already present, so it is
    58	/// not a constructor the engine needs a distinct token for.
    59	pub fn master_pset() -> Vec<(&'static str, usize)> {
    60	    vec![
    61	        ("add", 2),
    62	        ("sub", 2),
    63	        ("mul", 2),
    64	        ("div", 2),
    65	        ("neg", 1),
    66	        ("sin", 1),
    67	        ("cos", 1),
    68	        ("tan", 1),
    69	        ("log", 1),
    70	        ("exp", 1),
    71	        ("sqrt", 1),
    72	        ("abs", 1),
    73	        ("tanh", 1),
    74	        ("pow2", 1),
    75	        ("pow3", 1),
    76	        ("pow", 2),
    77	        ("inv", 1),
    78	        ("protected_sqrt", 1),
    79	        ("protected_log", 1),
    80	        ("protected_exp", 1),
    81	        ("protected_inv", 1),
    82	        ("protected_div", 2),
    83	    ]
    84	}
    85	
    86	/// Map a semantic id + child Math strings into a `Math` s-expression node.
    87	fn semantic_to_math(semantic: &str, children: &[String]) -> Result<String, String> {
    88	    let ctor = match (semantic, children.len()) {
    89	        ("add", 2) => "Add",
    90	        ("sub", 2) => "Sub",
    91	        ("mul", 2) => "Mul",
    92	        ("div", 2) => "Div",
    93	        ("neg", 1) => "Neg",
    94	        ("sin", 1) => "Sin",
    95	        ("cos", 1) => "Cos",
    96	        ("tan", 1) => "Tan",
    97	        ("log", 1) => "Log",
    98	        ("exp", 1) => "Exp",
    99	        ("sqrt", 1) => "Sqrt",
   100	        ("abs", 1) => "Abs",
   101	        ("tanh", 1) => "Tanh",
   102	        ("pow2", 1) => "Pow2",
   103	        ("pow3", 1) => "Pow3",
   104	        ("pow", 2) => "Pow",
   105	        ("inv", 1) => "Inv",
   106	        // protected ops — distinct constructors, never the raw ones
   107	        ("protected_sqrt", 1) => "ProtectedSqrt",
   108	        ("protected_log", 1) => "ProtectedLog",
   109	        ("protected_exp", 1) => "ProtectedExp",
   110	        ("protected_inv", 1) => "ProtectedInv",
   111	        ("protected_div", 2) => "ProtectedDiv",
   112	        // diff_sq(a,b) = (a-b)^2, expressed via Pow2(Sub a b).
   113	        ("diff_sq", 2) => {
   114	            return Ok(format!("(Pow2 (Sub {} {}))", children[0], children[1]));
   115	        }
   116	        _ => {
   117	            return Err(format!(
   118	                "unknown semantic_id/arity: {semantic}/{}",
   119	                children.len()
   120	            ))
   121	        }
   122	    };
   123	    Ok(format!("({ctor} {})", children.join(" ")))
   124	}
   125	
   126	/// Render a leaf token as a `Math` s-expression leaf.
   127	fn leaf_to_math(tok: &Token, pset: &PsetSpec) -> Result<String, String> {
   128	    match tok {
   129	        Token::Var(name) => {
   130	            if pset.variables.iter().any(|v| v == name) {
   131	                Ok(format!("(Var \"{name}\")"))
   132	            } else {
   133	                Err(format!("variable {name:?} not in pset"))
   134	            }
   135	        }
   136	        Token::Num(v) => {
   137	            if !v.is_finite() {
   138	                // egglog's parser has no literal for NaN/inf; rendering one
   139	                // would silently produce an unparseable program downstream.
   140	                Err(format!("non-finite numeric constant {v} is not expressible"))
   141	            } else {
   142	                Ok(format!("(Num {})", fmt_f64(*v)))
   143	            }
   144	        }
   145	        Token::Func(name) => Err(format!("function {name:?} used as a leaf")),
   146	    }
   147	}
   148	
   149	/// Format an f64 the way egglog's parser accepts (always with a decimal point).
   150	fn fmt_f64(v: f64) -> String {
   151	    if v.fract() == 0.0 && v.is_finite() {
   152	        format!("{v:.1}")
   153	    } else {
   154	        format!("{v}")
   155	    }
   156	}
   157	
   158	/// Convert a karva (head, tail) chromosome to a `Math` s-expression string.
   159	///
   160	/// Decodes the live expression by the GEP level-order rule and renders it.
   161	/// Neutral-region tokens (beyond the live expression) are ignored, exactly as
   162	/// they would be when the chromosome is evaluated.
   163	pub fn karva_to_terms(head: &[Token], tail: &[Token], pset: &PsetSpec) -> Result<String, String> {
   164	    if head.is_empty() {
   165	        return Err("empty head".to_string());
   166	    }
   167	    // The combined stream the GEP rule walks.
   168	    let stream: Vec<&Token> = head.iter().chain(tail.iter()).collect();
   169	
   170	    // Determine each function token's arity, walking the head and consuming
   171	    // child slots level-order. `child_slots[i]` = the stream indices of node
   172	    // i's children.
   173	    let mut children_of: Vec<Vec<usize>> = vec![Vec::new(); stream.len()];
   174	    let mut next_slot = 1usize;
   175	    for (i, tok) in head.iter().enumerate() {
   176	        // A token at or beyond `next_slot` was never assigned as any live
   177	        // node's child: it sits in the neutral (dead) region, which the GEP
   178	        // decode rule ignores. Since `next_slot` only grows from live function
   179	        // tokens, everything from here on is dead — stop, and never validate
   180	        // or consume slots for dead tokens (an unmapped token in the neutral
   181	        // region must not fail an otherwise valid chromosome).
   182	        if i > 0 && i >= next_slot {
   183	            break;
   184	        }
   185	        if let Token::Func(name) = tok {
   186	            let spec = pset
   187	                .functions
   188	                .get(name)
   189	                .ok_or_else(|| format!("function token {name:?} not in pset"))?;
   190	            for _ in 0..spec.arity {
   191	                if next_slot >= stream.len() {
   192	                    return Err(format!(
   193	                        "ran out of tokens decoding {name:?}: GEP tail too short"
   194	                    ));
   195	                }
   196	                children_of[i].push(next_slot);
   197	                next_slot += 1;
   198	            }
   199	        }
   200	    }
   201	
   202	    // Recursively render from the root (stream index 0). Depth-capped: a
   203	    // deeper-than-sane gene must surface as an Err, not a stack overflow.
   204	    fn render(
   205	        idx: usize,
   206	        stream: &[&Token],
   207	        children_of: &[Vec<usize>],
   208	        pset: &PsetSpec,
   209	        depth: usize,
   210	    ) -> Result<String, String> {
   211	        if depth > crate::MAX_EXPR_DEPTH {
   212	            return Err(format!(
   213	                "expression deeper than MAX_EXPR_DEPTH ({})",
   214	                crate::MAX_EXPR_DEPTH
   215	            ));
   216	        }
   217	        match stream[idx] {
   218	            Token::Func(name) => {
   219	                let spec = pset
   220	                    .functions
   221	                    .get(name)
   222	                    .ok_or_else(|| format!("function token {name:?} not in pset"))?;
   223	                let kids: Result<Vec<String>, String> = children_of[idx]
   224	                    .iter()
   225	                    .map(|&c| render(c, stream, children_of, pset, depth + 1))
   226	                    .collect();
   227	                semantic_to_math(&spec.semantic_id, &kids?)
   228	            }
   229	            leaf => leaf_to_math(leaf, pset),
   230	        }
   231	    }
   232	
   233	    render(0, &stream, &children_of, pset, 0)
   234	}
