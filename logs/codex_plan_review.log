  1316	fn pnode_tokenize(s: &str) -> Vec<String> {
  1317	    let mut out = Vec::new();
  1318	    let mut chars = s.chars().peekable();
  1319	    while let Some(&c) = chars.peek() {
  1320	        match c {
  1321	            '(' | ')' => {
  1322	                out.push(c.to_string());
  1323	                chars.next();
  1324	            }
  1325	            '"' => {
  1326	                let mut t = String::from("\"");
  1327	                chars.next();
  1328	                for c2 in chars.by_ref() {
  1329	                    if c2 == '"' {
  1330	                        break;
  1331	                    }
  1332	                    t.push(c2);
  1333	                }
  1334	                t.push('"');
  1335	                out.push(t);
  1336	            }
  1337	            c if c.is_whitespace() => {
  1338	                chars.next();
  1339	            }
  1340	            _ => {
  1341	                let mut t = String::new();
  1342	                while let Some(&c2) = chars.peek() {
  1343	                    if c2 == '(' || c2 == ')' || c2.is_whitespace() {
  1344	                        break;
  1345	                    }
  1346	                    t.push(c2);
  1347	                    chars.next();
  1348	                }
  1349	                out.push(t);
  1350	            }

